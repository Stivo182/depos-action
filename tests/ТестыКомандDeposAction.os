&Тест
Процедура ТестДолжен_ОпределитьЗарегистрированныйМанифест() Экспорт

    // Подготовка
    СоздатьКаталог(ОбъединитьПути(_Каталог, "project with spaces"));
    ЗаписатьФайл(ОбъединитьПути(_Каталог, "project with spaces/packagedef"), "manifest");
    ЗаписатьФайл(ОбъединитьПути(_Каталог, "project with spaces/secret.txt"), "secret");
    ИнициализироватьGit();
    ВыполнитьGit(МассивИз("add", "project with spaces/packagedef"));
    ПутьВывода = ОбъединитьПути(_Каталог, "github-env");
    ЗаписатьФайл(ПутьВывода, "");
    _Среда.Вставить("DEPOS_PACKAGEDEF", "project with spaces");
    _Среда.Вставить("GITHUB_ENV", ПутьВывода);

    // Действие
    Результат = ВыполнитьCLI("resolve-packagedef");

    // Проверка
    Утверждения.ПроверитьРавенство(0, Результат.КодВозврата, Результат.Вывод);
    Ожидаем.Что(ПрочитатьФайл(ПутьВывода)).Содержит("DEPOS_PACKAGEDEF=project with spaces/packagedef");
    Ожидаем.Что(ПрочитатьФайл(ПутьВывода)).Не_().Содержит("secret.txt");

