#Использовать 1commands
#Использовать tempfiles
#Использовать asserts

Перем _Менеджер;
Перем _Каталог;
Перем _Среда;
Перем _Сценарий;

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПодготовитьТест() Экспорт

    _Менеджер = Новый МенеджерВременныхФайлов;
    _Каталог = _Менеджер.СоздатьКаталог();
    _Среда = ПеременныеСреды();
    _Сценарий = Новый Файл(ОбъединитьПути(ТекущийКаталог(), "src/depos-action.os")).ПолноеИмя;

КонецПроцедуры

&ПослеКаждого
Процедура ЗавершитьТест() Экспорт

    _Менеджер.Удалить();

КонецПроцедуры

#КонецОбласти

#Область Тесты

&Тест
Процедура ТестДолжен_ПодготовитьПараметрыAction() Экспорт

    // Подготовка
    ПодготовитьВходныеПараметрыAction();
    _Среда.Вставить("DEPOS_PACKAGEDEF", "./fixtures\packagedef");

    // Действие
    Результат = ВыполнитьCLI("prepare");

    // Проверка
    Утверждения.ПроверитьРавенство(0, Результат.КодВозврата, Результат.Вывод);
    Вывод = ПрочитатьФайл(ОбъединитьПути(_Каталог, "github-env"));
    Ожидаем.Что(Вывод).Содержит("DEPOS_BRANCH=depos/bump-deps/latest");
    Ожидаем.Что(Вывод).Содержит("DEPOS_BASE=main");
    Ожидаем.Что(Вывод).Содержит("DEPOS_PACKAGEDEF=fixtures/packagedef");
    Ожидаем.Что(Вывод).Содержит("DEPOS_REPORT_PATH=" + ОбъединитьПути(_Каталог, "runner-temp")
        + "/depos-packages.json");

    ПроверитьНетВозвратовКаретки(ОбъединитьПути(_Каталог, "github-env"));

КонецПроцедуры

