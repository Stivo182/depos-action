&Тест
Процедура ТестДолжен_ОтклонитьСимвольнуюСсылкуВРабочемДереве() Экспорт

    // Подготовка
    Если ЭтоWindows() Тогда Возврат; КонецЕсли;
    ЗаписатьФайл(ОбъединитьПути(_Каталог, "packagedef"), "manifest");
    ЗаписатьФайл(ОбъединитьПути(_Каталог, "target"), "manifest");
    ИнициализироватьGit();
    ВыполнитьGit(МассивИз("add", "packagedef"));
    УдалитьФайлы(ОбъединитьПути(_Каталог, "packagedef"));
    СоздатьСимвольнуюСсылку("target", "packagedef");
    _Среда.Вставить("DEPOS_PACKAGEDEF", "packagedef");
    _Среда.Вставить("GITHUB_ENV", ОбъединитьПути(_Каталог, "github-env"));

    // Действие
    Результат = ВыполнитьCLI("resolve-packagedef");

    // Проверка
    Утверждения.ПроверитьРавенство(1, Результат.КодВозврата);
    Ожидаем.Что(Результат.Вывод).Содержит("Недопустимый packagedef");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СформироватьВыводPullRequest() Экспорт

    // Подготовка
    ПутьОтчета = ОбъединитьПути(_Каталог, "report.json");
    ЗаписатьФайл(ПутьОтчета, ОтчетОбОбновлении());
    ПутьВывода = ОбъединитьПути(_Каталог, "github-output");
    ЗаписатьФайл(ПутьВывода, "");

    _Среда.Вставить("DEPOS_REPORT_PATH", ПутьОтчета);
    _Среда.Вставить("GITHUB_OUTPUT", ПутьВывода);
    _Среда.Вставить("DEPOS_MESSAGE_PREFIX", "build(deps)");
    _Среда.Вставить("DEPOS_PACKAGEDEF", "packagedef");
    _Среда.Вставить("DEPOS_TARGET", "latest");
    _Среда.Вставить("DEPOS_ENGINE", "2.2.0");
    _Среда.Вставить("GH_TOKEN", "");

    // Действие
    Результат = ВыполнитьCLI("format-pr");

    // Проверка
    Утверждения.ПроверитьРавенство(0, Результат.КодВозврата, Результат.Вывод);
    Вывод = ПрочитатьФайл(ПутьВывода);
    Ожидаем.Что(Вывод).Содержит("title<<depos_");
    Ожидаем.Что(Вывод).Содержит("body<<depos_");
    Ожидаем.Что(Вывод).Не_().Содержит("body<<EOF");
    Ожидаем.Что(Вывод).Содержит("build(deps): Bump semver 1.0.0 → 1.1.0");
    Ожидаем.Что(Вывод).Содержит("Strategy: `latest` · OneScript: `2.2.0`");
    Ожидаем.Что(Вывод).Содержит("<!-- depos-action: managed pull request -->");

    ПроверитьНетВозвратовКаретки(ПутьВывода);

КонецПроцедуры

