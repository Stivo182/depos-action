КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПодготовитьВходныеПараметрыAction()

    _Среда.Вставить("DEPOS_TARGET", "latest");
    _Среда.Вставить("DEPOS_PACKAGEDEF", "packagedef");
    _Среда.Вставить("DEPOS_BRANCH", "");
    _Среда.Вставить("DEPOS_BASE", "");
    _Среда.Вставить("DEPOS_DEFAULT_BRANCH", "main");
    _Среда.Вставить("DEPOS_TRIGGER_REF_NAME", "main");
    _Среда.Вставить("RUNNER_TEMP", ОбъединитьПути(_Каталог, "runner-temp"));
    _Среда.Вставить("GITHUB_ENV", ОбъединитьПути(_Каталог, "github-env"));

    ЗаписатьФайл(ОбъединитьПути(_Каталог, "github-env"), "");

КонецПроцедуры

Функция ВыполнитьCLI(ИмяКоманды)

    Параметры = МассивИз(_Сценарий, ИмяКоманды);
    Возврат ВыполнитьПроцесс("oscript", Параметры);

КонецФункции

Функция ВыполнитьПроцесс(Имя, Аргументы)

    Команда = Новый Команда;
    Команда.УстановитьКоманду(Имя);
    Команда.УстановитьРабочийКаталог(_Каталог);
    Команда.УстановитьИсполнениеЧерезКомандыСистемы(Ложь);
    Команда.УстановитьПеременныеСреды(_Среда);

    Для Каждого Аргумент Из Аргументы Цикл
        Команда.ДобавитьПараметр("""" + Аргумент + """");
    КонецЦикла;

    КодВозврата = Команда.Исполнить();

    Возврат Новый Структура("КодВозврата,Вывод", КодВозврата, Команда.ПолучитьВывод());

КонецФункции

Процедура ИнициализироватьGit()

    Результат = ВыполнитьПроцесс("git", МассивИз("init", "-q"));
    Утверждения.ПроверитьРавенство(0, Результат.КодВозврата, Результат.Вывод);

КонецПроцедуры

Процедура ВыполнитьGit(Аргументы)

    Результат = ВыполнитьПроцесс("git", Аргументы);
    Утверждения.ПроверитьРавенство(0, Результат.КодВозврата, Результат.Вывод);

КонецПроцедуры

Процедура СоздатьСимвольнуюСсылку(Цель, Путь)

    Результат = ВыполнитьПроцесс("ln", МассивИз("-s", Цель, Путь));
    Утверждения.ПроверитьРавенство(0, Результат.КодВозврата, Результат.Вывод);

КонецПроцедуры

Функция МассивИз(Значение1, Значение2 = Неопределено, Значение3 = Неопределено,
    Значение4 = Неопределено)

    Результат = Новый Массив;
    Результат.Добавить(Значение1);

    Если Значение2 <> Неопределено Тогда Результат.Добавить(Значение2); КонецЕсли;
    Если Значение3 <> Неопределено Тогда Результат.Добавить(Значение3); КонецЕсли;
    Если Значение4 <> Неопределено Тогда Результат.Добавить(Значение4); КонецЕсли;

    Возврат Результат;

КонецФункции

Функция ЭтоWindows()

    Информация = Новый СистемнаяИнформация;
    Возврат СтрНачинаетсяС(Строка(Информация.ТипПлатформы), "Windows");

КонецФункции

Процедура ЗаписатьФайл(Путь, Содержимое)

    Запись = Новый ЗаписьТекста(Путь, "UTF-8");
    Запись.Записать(Содержимое);
    Запись.Закрыть();

КонецПроцедуры

Функция ПрочитатьФайл(Путь)

    Чтение = Новый ЧтениеТекста(Путь, "UTF-8");
    Содержимое = Чтение.Прочитать();
    Чтение.Закрыть();
    Возврат Содержимое;

КонецФункции

Процедура ПроверитьНетВозвратовКаретки(Путь)

    Чтение = Новый ЧтениеДанных(Путь);
    НайденВозвратКаретки = Ложь;
    Для Номер = 1 По Новый Файл(Путь).Размер() Цикл
        Если Чтение.ПрочитатьБайт() = 13 Тогда
            НайденВозвратКаретки = Истина;
            Прервать;
        КонецЕсли;
    КонецЦикла;
    Чтение.Закрыть();
    Ожидаем.Что(НайденВозвратКаретки).ЭтоЛожь();

КонецПроцедуры

Функция ОтчетОбОбновлении()

    Возврат "[{""packageName"":""semver"",""currentMinVersion"":""1.0.0"",""targetMinVersion"":""1.1.0""}]";

КонецФункции

#КонецОбласти
