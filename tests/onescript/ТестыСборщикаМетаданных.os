#Область Тесты

&Тест
Процедура ТестДолжен_СобратьРелизыДиапазонаИКоммиты() Экспорт

    // Подготовка
    Клиент = Новый ФиктивныйКлиентGitHub;
    Клиент.ДобавитьРепозиторий("oscript-library/pkg");
    Клиент.ДобавитьТег("oscript-library/pkg", "1.0.0", "v1.0.0");
    Клиент.ДобавитьТег("oscript-library/pkg", "1.2.0", "v1.2.0");
    Клиент.ДобавитьСравнение("oscript-library/pkg", "v1.0.0", "v1.2.0");
    Клиент.ДобавитьКоммит("oscript-library/pkg", "v1.0.0", "v1.2.0", "abcdef123456", "Useful change");
    Клиент.ДобавитьРелиз("oscript-library/pkg", "v1.0.0", "1.0.0", "Old notes");
    Клиент.ДобавитьРелиз("oscript-library/pkg", "v1.1.0", "1.1.0", "First notes");
    Клиент.ДобавитьРелиз("oscript-library/pkg", "v1.2.0", "1.2.0", "Second notes");
    Клиент.ДобавитьРелиз("oscript-library/pkg", "v1.1.5", "Draft", "Hidden", Истина);
    Клиент.ДобавитьФайл("oscript-library/pkg", "CHANGELOG.md", "v1.2.0", "## 1.2.0");

    Определитель = Новый ОпределительРепозитория(Клиент);
    Сборщик = Новый СборщикМетаданныхОбновления(Определитель, Клиент);
    Обновление = Новый Структура("ИмяПакета,ВерсияДо,ВерсияПосле,Тип", "pkg", "1.0.0", "1.2.0", "minor");

    // Действие
    Результат = Сборщик.Обогатить(Обновление);

    // Проверка
    Утверждения.ПроверитьРавенство("https://github.com/oscript-library/pkg", Результат.URLРепозитория);
    Утверждения.ПроверитьРавенство(2, Результат.Релизы.Количество());
    Утверждения.ПроверитьРавенство("1.2.0", Результат.Релизы[0].Название);
    Утверждения.ПроверитьРавенство("1.1.0", Результат.Релизы[1].Название);
    Утверждения.ПроверитьРавенство(1, Результат.Коммиты.Количество());
    Утверждения.ПроверитьРавенство("abcdef123456", Результат.Коммиты[0].SHA);
    Ожидаем.Что(Результат.URLСравнения).Содержит("/compare/v1.0.0...v1.2.0");

    Ченджлог = "";
    Ожидаем.Что(Результат.Свойство("Ченджлог", Ченджлог)).ЭтоИстина();
    Утверждения.ПроверитьРавенство("## 1.2.0", Ченджлог);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьHubПриОтсутствииРепозитория() Экспорт

    // Подготовка
    Клиент = Новый ФиктивныйКлиентGitHub;
    Сборщик = Новый СборщикМетаданныхОбновления(Новый ОпределительРепозитория(Клиент), Клиент);
    Обновление = Новый Структура("ИмяПакета,ВерсияДо,ВерсияПосле,Тип", "missing", "1.0.0", "1.0.1", "patch");

    // Действие
    Результат = Сборщик.Обогатить(Обновление);

    // Проверка
    Утверждения.ПроверитьРавенство("https://hub.oscript.io/package/missing", Результат.URLHub);
    Утверждения.ПроверитьРавенство(0, Результат.Релизы.Количество());
    Утверждения.ПроверитьРавенство(0, Результат.Коммиты.Количество());

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОбработатьПустыеНазваниеИТекстРелиза() Экспорт

    // Подготовка
    Клиент = Новый ФиктивныйКлиентGitHub;
    Клиент.ДобавитьРепозиторий("oscript-library/pkg");
    Клиент.ДобавитьТег("oscript-library/pkg", "1.0.0", "v1.0.0");
    Клиент.ДобавитьТег("oscript-library/pkg", "1.0.1", "v1.0.1");
    Клиент.ДобавитьСравнение("oscript-library/pkg", "v1.0.0", "v1.0.1");
    Клиент.ДобавитьРелиз("oscript-library/pkg", "v1.0.1", Null, Null);

    Сборщик = Новый СборщикМетаданныхОбновления(Новый ОпределительРепозитория(Клиент), Клиент);
    Обновление = Новый Структура("ИмяПакета,ВерсияДо,ВерсияПосле,Тип", "pkg", "1.0.0", "1.0.1", "patch");

    // Действие
    Результат = Сборщик.Обогатить(Обновление);

    // Проверка
    Утверждения.ПроверитьРавенство("1.0.1", Результат.Релизы[0].Название);
    Утверждения.ПроверитьРавенство("", Результат.Релизы[0].Текст);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВключитьРелизСПрефиксомVer() Экспорт

    // Подготовка
    Клиент = Новый ФиктивныйКлиентGitHub;
    Клиент.ДобавитьРепозиторий("oscript-library/pkg");
    Клиент.ДобавитьТег("oscript-library/pkg", "1.0.0", "ver1.0.0");
    Клиент.ДобавитьТег("oscript-library/pkg", "1.1.0", "ver1.1.0");
    Клиент.ДобавитьСравнение("oscript-library/pkg", "ver1.0.0", "ver1.1.0");
    Клиент.ДобавитьРелиз("oscript-library/pkg", "ver1.1.0", "Release", "Notes");

    Сборщик = Новый СборщикМетаданныхОбновления(Новый ОпределительРепозитория(Клиент), Клиент);
    Обновление = Новый Структура("ИмяПакета,ВерсияДо,ВерсияПосле,Тип", "pkg", "1.0.0", "1.1.0", "minor");

    // Действие
    Результат = Сборщик.Обогатить(Обновление);

    // Проверка
    Утверждения.ПроверитьРавенство(1, Результат.Релизы.Количество());
    Утверждения.ПроверитьРавенство("1.1.0", Результат.Релизы[0].Версия);
    Утверждения.ПроверитьРавенство("ver1.1.0", Результат.Релизы[0].Тег);

КонецПроцедуры

#КонецОбласти
