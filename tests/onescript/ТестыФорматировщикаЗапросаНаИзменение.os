&Тест
Процедура ТестДолжен_ОграничитьБольшуюСводнуюТаблицу() Экспорт

    // Подготовка
    Обновления = Новый Массив;
    Для Номер = 1 По 500 Цикл
        Обновления.Добавить(Обновление(
            "package-with-a-long-name-" + Строка(Номер),
            "1.0.0",
            "1.0.1",
            "patch"
        ));
    КонецЦикла;
    Форматировщик = Новый ФорматировщикЗапросаНаИзменение;

    // Действие
    Результат = Форматировщик.Сформировать(Обновления, "", "packagedef", "latest");

    // Проверка
    Ожидаем.Что(СтрДлина(Результат.Тело) <= 60000).ЭтоИстина();
    Ожидаем.Что(Результат.Тело).Содержит("_Additional dependency rows were truncated._");
    Ожидаем.Что(Результат.Тело).Содержит(
        "<sub>Created automatically by [depos-action](https://github.com/Stivo182/depos-action)"
    );

КонецПроцедуры

&Тест
Процедура ТестДолжен_ДобавлятьТолькоЦелыеБлокиВПределахЛимита() Экспорт

    // Подготовка
    Пакет = Обновление("pkg", "1.0.0", "1.0.1", "patch");
    ДлиннаяСтрока = "";
    Для Номер = 1 По 2000 Цикл
        ДлиннаяСтрока = ДлиннаяСтрока + "x";
    КонецЦикла;
    Строки = Новый Массив;
    Для Номер = 1 По 50 Цикл
        Строки.Добавить(ДлиннаяСтрока);
    КонецЦикла;
    Пакет.Релизы.Добавить(Новый Структура(
        "Название,Текст,URL",
        "1.0.1",
        СтрСоединить(Строки, Символы.ПС),
        "https://github.com/oscript-library/pkg/releases/tag/v1.0.1"
    ));
    Форматировщик = Новый ФорматировщикЗапросаНаИзменение;

    // Действие
    Результат = Форматировщик.Сформировать(МассивИз(Пакет), "", "packagedef", "latest");

    // Проверка
    Ожидаем.Что(СтрДлина(Результат.Тело) <= 60000).ЭтоИстина();
    Ожидаем.Что(Результат.Тело).Не_().Содержит("<details>");
    Ожидаем.Что(Результат.Тело).Содержит("_Additional dependency details were truncated._");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Обновление(Имя, До, После, Тип)

    Результат = Новый Структура(
        "ИмяПакета,ВерсияДо,ВерсияПосле,Тип,URLРепозитория,URLHub,Релизы,Коммиты,URLСравнения",
        Имя,
        До,
        После,
        Тип,
        СтрШаблон("https://github.com/oscript-library/%1", Имя),
        СтрШаблон("https://hub.oscript.io/package/%1", Имя),
        Новый Массив,
        Новый Массив,
        ""
    );

    Возврат Результат;

КонецФункции

Функция МассивИз(Значение)

    Результат = Новый Массив;
    Результат.Добавить(Значение);

    Возврат Результат;

КонецФункции

#КонецОбласти
