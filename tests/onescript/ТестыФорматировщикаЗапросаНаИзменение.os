&Тест
Процедура ТестДолжен_ОбезвредитьВнешнийMarkdown() Экспорт

    // Подготовка
    Пакет = Обновление("pkg", "1.0.0", "1.0.1", "patch");
    Пакет.Релизы.Добавить(Новый Структура(
        "Название,Текст,URL,Тег",
        "1.0.1",
        "Thanks @maintainer <DETAILS><SUMMARY>x</SUMMARY></DETAILS>",
        "https://github.com/oscript-library/pkg/releases/tag/v1.0.1",
        "v1.0.1"
    ));
    Форматировщик = Новый ФорматировщикЗапросаНаИзменение;

    // Действие
    Результат = Форматировщик.Сформировать(МассивИз(Пакет), "", "packagedef", "latest");

    // Проверка
    Ожидаем.Что(Результат.Тело).Содержит("@" + Символ(8203) + "maintainer");
    Ожидаем.Что(Результат.Тело).Содержит("&lt;DETAILS>&lt;SUMMARY>x&lt;/SUMMARY>&lt;/DETAILS>");

