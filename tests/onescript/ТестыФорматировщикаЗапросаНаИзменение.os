&Тест
Процедура ТестДолжен_РазрешитьОтносительныеСсылкиПоТегуРелиза() Экспорт

    // Подготовка
    Пакет = Обновление("pkg", "1.0.0", "1.0.1", "patch");
    Пакет.Релизы.Добавить(Новый Структура(
        "Название,Текст,URL,Тег",
        "1.0.1",
        "](/owner/pkg/issues/1) [docs](docs/readme.md) "
            + "[title](docs/title.md ""Docs"") [parentheses](docs/a_(b).md)",
        "https://github.com/oscript-library/pkg/releases/tag/v1.0.1",
        "v1.0.1"
    ));
    Форматировщик = Новый ФорматировщикЗапросаНаИзменение;

    // Действие
    Результат = Форматировщик.Сформировать(МассивИз(Пакет), "", "packagedef", "latest");

    // Проверка
    Ожидаем.Что(Результат.Тело).Содержит("](https://github.com/owner/pkg/issues/1)");
    Ожидаем.Что(Результат.Тело).Содержит("](https://github.com/oscript-library/pkg/blob/v1.0.1/docs/readme.md)");
    Ожидаем.Что(Результат.Тело).Содержит(
        "](https://github.com/oscript-library/pkg/blob/v1.0.1/docs/title.md ""Docs"")"
    );
    Ожидаем.Что(Результат.Тело).Содержит(
        "](https://github.com/oscript-library/pkg/blob/v1.0.1/docs/a_(b).md)"
    );

