#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СформироватьJSONРелизов(НачальныйНомер, Количество)

    Релизы = Новый Массив;
    Для Номер = НачальныйНомер По НачальныйНомер + Количество - 1 Цикл
        Шаблон = "{""tag_name"":""v1.0.%1"",""name"":""%1"",""body"":"""",";
        Шаблон = Шаблон + """html_url"":""https://example/%1"",""draft"":false,";
        Шаблон = Шаблон + """prerelease"":false}";
        Релизы.Добавить(СтрШаблон(
            Шаблон,
            Номер
        ));
    КонецЦикла;

    Возврат "[" + СтрСоединить(Релизы, ",") + "]";

КонецФункции

Функция СформироватьJSONКоммитов(НачальныйНомер, Количество)

    Коммиты = Новый Массив;
    Для Номер = НачальныйНомер По НачальныйНомер + Количество - 1 Цикл
        Коммиты.Добавить(СтрШаблон(
            "{""sha"":""sha-%1"",""html_url"":""https://example/%1"",""commit"":{""message"":""Commit %1""}}",
            Номер
        ));
    КонецЦикла;

    Возврат "[" + СтрСоединить(Коммиты, ",") + "]";

КонецФункции

#КонецОбласти
