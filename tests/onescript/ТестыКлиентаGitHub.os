    // Проверка
    Утверждения.ПроверитьРавенство("ver1.8.0", Тег);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗагрузитьВсеСтраницыРелизов() Экспорт

    // Подготовка
    Транспорт = Новый ФиктивныйHTTPТранспорт;
    Транспорт.ДобавитьОтвет(
        "/repos/oscript-library/pkg/releases?per_page=100&page=1",
        200,
        СформироватьJSONРелизов(1, 100)
    );
    Транспорт.ДобавитьОтвет(
        "/repos/oscript-library/pkg/releases?per_page=100&page=2",
        200,
        СформироватьJSONРелизов(101, 1)
    );
    Клиент = Новый КлиентGitHub("https://api.github.com", "secret", Неопределено, Транспорт);

    // Действие
    Релизы = Клиент.ПолучитьРелизы("oscript-library/pkg");

    // Проверка
    Утверждения.ПроверитьРавенство(101, Релизы.Количество());

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПрочитатьРелизыСРеакциямиGitHub() Экспорт

    // Подготовка
    Транспорт = Новый ФиктивныйHTTPТранспорт;
    ТелоРелизов = "[{
        |""tag_name"":""ver1.8.0"",""name"":""Release"",""body"":""Notes"",
        |""html_url"":""https://example/release"",""draft"":false,""prerelease"":false,
        |""reactions"":{""total_count"":1,""+1"":1,""-1"":0}
        |}]";
    Транспорт.ДобавитьОтвет("/repos/owner/pkg/releases?per_page=100&page=1", 200, ТелоРелизов);
    Клиент = Новый КлиентGitHub("https://api.github.com", "secret", Неопределено, Транспорт);

    // Действие
    Релизы = Клиент.ПолучитьРелизы("owner/pkg");

    // Проверка
    Утверждения.ПроверитьРавенство(1, Релизы.Количество());
    Утверждения.ПроверитьРавенство("ver1.8.0", Релизы[0].tag_name);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПолучитьПоследнююСтраницуБольшогоСравнения() Экспорт

    // Подготовка
    Транспорт = Новый ФиктивныйHTTPТранспорт;
    ПервыйОтвет = "{
        |""html_url"":""https://github.com/oscript-library/pkg/compare/v1...v2"",
        |""total_commits"":251,
        |""commits"":[{""sha"":""old"",""html_url"":""https://example/old"",""commit"":{""message"":""Old""}}]
        |}";
    ПоследнийОтвет = "{
        |""html_url"":""https://github.com/oscript-library/pkg/compare/v1...v2"",
        |""total_commits"":251,
        |""commits"":[
        |{""sha"":""new-250"",""html_url"":""https://example/250"",""commit"":{""message"":""New 250""}},
        |{""sha"":""new-251"",""html_url"":""https://example/251"",""commit"":{""message"":""New 251""}}]
        |}";
    ПредыдущийОтвет = СтрШаблон(
        "{""html_url"":""https://example/compare"",""total_commits"":251,""commits"":%1}",
        СформироватьJSONКоммитов(241, 9)
    );
    Транспорт.ДобавитьОтвет(
        "/repos/oscript-library/pkg/compare/v1...v2?per_page=100&page=1",
        200,
        ПервыйОтвет
    );
    Транспорт.ДобавитьОтвет(
        "/repos/oscript-library/pkg/compare/v1...v2?per_page=100&page=2",
        200,
        ПредыдущийОтвет
    );
    Транспорт.ДобавитьОтвет(
        "/repos/oscript-library/pkg/compare/v1...v2?per_page=100&page=3",
        200,
        ПоследнийОтвет
    );
    Клиент = Новый КлиентGitHub("https://api.github.com", "secret", Неопределено, Транспорт);

    // Действие
    Сравнение = Клиент.Сравнить("oscript-library/pkg", "v1", "v2");

    // Проверка
    Утверждения.ПроверитьРавенство(11, Сравнение.Коммиты.Количество());
    Утверждения.ПроверитьРавенство("new-251", Сравнение.Коммиты[10].sha);

КонецПроцедуры

