#Область Тесты

&Тест
Процедура ТестДолжен_НормализоватьОтветыGitHub() Экспорт

    // Подготовка
    Транспорт = Новый ФиктивныйHTTPТранспорт;
    ТелоРепозитория = "{
        |""full_name"":""oscript-library/pkg"",
        |""html_url"":""https://github.com/oscript-library/pkg"",
        |""fork"":true,""archived"":false,""disabled"":false,""pushed_at"":null,
        |""parent"":{""full_name"":""owner/pkg""},
        |""source"":{""full_name"":""root/pkg""}
        |}";
    Транспорт.ДобавитьОтвет("/repos/oscript-library/pkg", 200, ТелоРепозитория);
    Транспорт.ДобавитьОтвет("/repos/oscript-library/pkg/git/ref/tags/1.2.3", 404, "{}");
    Транспорт.ДобавитьОтвет("/repos/oscript-library/pkg/git/ref/tags/v1.2.3", 200, "{""ref"":""refs/tags/v1.2.3""}");
    ТелоСравнения = "{
        |""html_url"":""https://github.com/oscript-library/pkg/compare/v1.0.0...v1.2.3"",
        |""commits"":[]
        |}";
    Транспорт.ДобавитьОтвет(
        "/repos/oscript-library/pkg/compare/v1.0.0...v1.2.3?per_page=100&page=1",
        200,
        ТелоСравнения
    );
    ТелоРелизов = "[{
        |""tag_name"":""v1.2.3"",""name"":""Release"",""body"":""Notes"",
        |""html_url"":""https://example/release"",""draft"":false,""prerelease"":false
        |}]";
    Транспорт.ДобавитьОтвет("/repos/oscript-library/pkg/releases?per_page=100&page=1", 200, ТелоРелизов);
    Клиент = Новый КлиентGitHub("https://api.github.com", "secret", Неопределено, Транспорт);

    // Действие
    Репозиторий = Клиент.ПолучитьРепозиторий("oscript-library/pkg");
    Тег = Клиент.РазрешитьТег("oscript-library/pkg", "1.2.3");
    Сравнение = Клиент.Сравнить("oscript-library/pkg", "v1.0.0", "v1.2.3");
    Релизы = Клиент.ПолучитьРелизы("oscript-library/pkg");

    // Проверка
    Утверждения.ПроверитьРавенство("owner/pkg", Репозиторий.Родитель);
    Утверждения.ПроверитьРавенство("root/pkg", Репозиторий.Источник);
    Утверждения.ПроверитьРавенство("", Репозиторий.Обновлен);
    Утверждения.ПроверитьРавенство("v1.2.3", Тег);
    Ожидаем.Что(Сравнение.URL).Содержит("/compare/v1.0.0...v1.2.3");
    Утверждения.ПроверитьРавенство(1, Релизы.Количество());
    Утверждения.ПроверитьРавенство("depos-action", Транспорт.ПоследнийЗаголовок("User-Agent"));

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазрешитьТегСПрефиксомVer() Экспорт

