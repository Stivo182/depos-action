#Использовать asserts
#Использовать "../../scripts/pr"

#Область Тесты

&Тест
Процедура ТестДолжен_ОпределитьТипыОбновлений() Экспорт

    // Подготовка
    Примеры = Новый Массив;
    Примеры.Добавить(Новый Структура("До,После,Тип", "1.2.3", "2.0.0", "major"));
    Примеры.Добавить(Новый Структура("До,После,Тип", "1.2.3", "1.3.0", "minor"));
    Примеры.Добавить(Новый Структура("До,После,Тип", "1.2.3", "1.2.4", "patch"));

    Для Каждого Пример Из Примеры Цикл
        Путь = ЗаписатьВременныйОтчет(СтрШаблон(
            "[{""packageName"":""pkg"",""minVersionBefore"":""%1"",""minVersionAfter"":""%2""}]",
            Пример.До,
            Пример.После
        ));
        Читатель = Новый ОтчетОбновлений;

        // Действие
        Обновления = Читатель.Прочитать(Путь);

        // Проверка
        Утверждения.ПроверитьРавенство(Пример.Тип, Обновления[0].Тип);
        УдалитьФайлы(Путь);
    КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПрочитатьОтчетDepos() Экспорт

    // Подготовка
    Путь = ЗаписатьВременныйОтчет(
        "[{""packageName"":""autumn"",""minVersionBefore"":""4.3.10"",""minVersionAfter"":""4.3.11""}]"
    );

    Читатель = Новый ОтчетОбновлений;

    // Действие
    Обновления = Читатель.Прочитать(Путь);

    // Проверка
    Утверждения.ПроверитьРавенство(1, Обновления.Количество());
    Утверждения.ПроверитьРавенство("autumn", Обновления[0].ИмяПакета);
    Утверждения.ПроверитьРавенство("4.3.10", Обновления[0].ВерсияДо);
    Утверждения.ПроверитьРавенство("4.3.11", Обновления[0].ВерсияПосле);
    Утверждения.ПроверитьРавенство("patch", Обновления[0].Тип);
    УдалитьФайлы(Путь);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьПустойОтчет() Экспорт

    // Подготовка
    Путь = ЗаписатьВременныйОтчет("[]");
    Ошибка = "";

    Читатель = Новый ОтчетОбновлений;

    // Действие
    Попытка
        Читатель.Прочитать(Путь);
    Исключение
        Ошибка = ОписаниеОшибки();
    КонецПопытки;

    // Проверка
    Ожидаем.Что(Ошибка).Содержит("Некорректный отчёт depos");
    УдалитьФайлы(Путь);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьНеполнуюЗапись() Экспорт

    // Подготовка
    Путь = ЗаписатьВременныйОтчет("[{""packageName"":""autumn""}]");
    Ошибка = "";

    Читатель = Новый ОтчетОбновлений;

    // Действие
    Попытка
        Читатель.Прочитать(Путь);
    Исключение
        Ошибка = ОписаниеОшибки();
    КонецПопытки;

    // Проверка
    Ожидаем.Что(Ошибка).Содержит("Некорректный отчёт depos");
    УдалитьФайлы(Путь);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЗаписатьВременныйОтчет(Содержимое)

    Путь = ПолучитьИмяВременногоФайла("json");
    Запись = Новый ЗаписьТекста(Путь, "UTF-8");
    Запись.Записать(Содержимое);
    Запись.Закрыть();

    Возврат Путь;

КонецФункции

#КонецОбласти
