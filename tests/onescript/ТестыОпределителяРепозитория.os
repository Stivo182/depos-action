#Область Тесты

&Тест
Процедура ТестДолжен_ВыбратьИсточникПриРавныхТегахИАктивности() Экспорт

    // Подготовка
    Клиент = Новый ФиктивныйКлиентGitHub;
    Клиент.ДобавитьРепозиторий("oscript-library/pkg", Истина, "owner/pkg", "owner/pkg");
    Клиент.ДобавитьРепозиторий("owner/pkg");
    ДобавитьДиапазон(Клиент, "oscript-library/pkg", "1.0.0", "1.1.0");
    ДобавитьДиапазон(Клиент, "owner/pkg", "1.0.0", "1.1.0");
    Определитель = Новый ОпределительРепозитория(Клиент);

    // Действие
    Результат = Определитель.Определить("pkg", "1.0.0", "1.1.0");

    // Проверка
    Утверждения.ПроверитьРавенство("owner/pkg", Результат.ПолноеИмя);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыбратьБолееСвежийФоркПриРавныхТегах() Экспорт

    // Подготовка
    Клиент = Новый ФиктивныйКлиентGitHub;
    Клиент.ДобавитьРепозиторий(
        "oscript-library/pkg", Истина, "owner/pkg", "owner/pkg", Ложь, "2026-09-01T00:00:00Z"
    );
    Клиент.ДобавитьРепозиторий("owner/pkg", Ложь, "", "", Ложь, "2025-01-01T00:00:00Z");
    ДобавитьДиапазон(Клиент, "oscript-library/pkg", "1.0.0", "1.1.0");
    ДобавитьДиапазон(Клиент, "owner/pkg", "1.0.0", "1.1.0");
    Определитель = Новый ОпределительРепозитория(Клиент);

    // Действие
    Результат = Определитель.Определить("pkg", "1.0.0", "1.1.0");

    // Проверка
    Утверждения.ПроверитьРавенство("oscript-library/pkg", Результат.ПолноеИмя);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьАктивныйИсточникПриОтсутствииТегов() Экспорт

    // Подготовка
    Клиент = Новый ФиктивныйКлиентGitHub;
    Клиент.ДобавитьРепозиторий("oscript-library/pkg", Истина, "owner/pkg", "owner/pkg", Истина);
    Клиент.ДобавитьРепозиторий("owner/pkg");
    Определитель = Новый ОпределительРепозитория(Клиент);

    // Действие
    Результат = Определитель.Определить("pkg", "1.0.0", "1.1.0");

    // Проверка
    ПолноеИмя = ?(Результат = Неопределено, "", Результат.ПолноеИмя);
    Утверждения.ПроверитьРавенство("owner/pkg", ПолноеИмя);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НайтиНормализованныйТегДляКороткойВерсии() Экспорт

    // Подготовка
    Клиент = Новый ФиктивныйКлиентGitHub;
    Клиент.ДобавитьРепозиторий("oscript-library/pkg");
    Клиент.ДобавитьТег("oscript-library/pkg", "0.7.0", "v0.7.0");
    Клиент.ДобавитьТег("oscript-library/pkg", "0.8.0", "v0.8.0");
    Клиент.ДобавитьСравнение("oscript-library/pkg", "v0.7.0", "v0.8.0");
    Определитель = Новый ОпределительРепозитория(Клиент);

    // Действие
    Результат = Определитель.Определить("pkg", "0.7", "0.8");

    // Проверка
    Утверждения.ПроверитьРавенство("v0.7.0", Результат.ТегДо);
    Утверждения.ПроверитьРавенство("v0.8.0", Результат.ТегПосле);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыбратьUpstreamСПолнымДиапазоном() Экспорт

    // Подготовка
    Клиент = Новый ФиктивныйКлиентGitHub;
    Клиент.ДобавитьРепозиторий("oscript-library/pkg", Истина, "owner/pkg", "owner/pkg");
    Клиент.ДобавитьРепозиторий("owner/pkg");
    Клиент.ДобавитьТег("oscript-library/pkg", "1.1.0", "v1.1.0");
    ДобавитьДиапазон(Клиент, "owner/pkg", "1.0.0", "1.1.0");
    Определитель = Новый ОпределительРепозитория(Клиент);

    // Действие
    Результат = Определитель.Определить("pkg", "1.0.0", "1.1.0");

    // Проверка
    Утверждения.ПроверитьРавенство("owner/pkg", Результат.ПолноеИмя);
    Утверждения.ПроверитьРавенство("v1.0.0", Результат.ТегДо);
    Утверждения.ПроверитьРавенство("v1.1.0", Результат.ТегПосле);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПредпочестьНеархивныйРепозиторий() Экспорт

    // Подготовка
    Клиент = Новый ФиктивныйКлиентGitHub;
    Клиент.ДобавитьРепозиторий("oscript-library/pkg", Истина, "owner/pkg", "owner/pkg", Истина);
    Клиент.ДобавитьРепозиторий("owner/pkg");
    ДобавитьДиапазон(Клиент, "oscript-library/pkg", "1.0.0", "1.1.0");
    ДобавитьДиапазон(Клиент, "owner/pkg", "1.0.0", "1.1.0");
    Определитель = Новый ОпределительРепозитория(Клиент);

    // Действие
    Результат = Определитель.Определить("pkg", "1.0.0", "1.1.0");

    // Проверка
    Утверждения.ПроверитьРавенство("owner/pkg", Результат.ПолноеИмя);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьДиапазон(Клиент, Репозиторий, ВерсияДо, ВерсияПосле)

    Клиент.ДобавитьТег(Репозиторий, ВерсияДо, "v" + ВерсияДо);
    Клиент.ДобавитьТег(Репозиторий, ВерсияПосле, "v" + ВерсияПосле);
    Клиент.ДобавитьСравнение(Репозиторий, "v" + ВерсияДо, "v" + ВерсияПосле);

КонецПроцедуры

#КонецОбласти
