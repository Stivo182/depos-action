#Использовать "../src/cli"
#Использовать "."
#Использовать asserts

#Область Тесты

&Тест
Процедура ТестДолжен_ПередатьРежимДвижкаВDepos() Экспорт

    Для Каждого Движок Из СтрРазделить("auto,current,2.2.0", ",") Цикл
        // Подготовка
        Исполнитель = Новый ФиктивныйИсполнительОбновления;
        Параметры = Новый ПараметрыСредыAction;
        Параметры.ВерсияDepos = "0.8.0";
        Параметры.Движок = Движок;
        Параметры.Манифест = "packagedef";
        Команда = Новый КомандаОбновленияЗависимостей(Исполнитель, Параметры);

        // Действие
        Команда.ВыполнитьКоманду(Неопределено);

        // Проверка
        Вызовы = Исполнитель.Вызовы();
        Утверждения.ПроверитьРавенство("depos", Вызовы[Вызовы.Количество() - 1].Имя);
        Аргументы = Вызовы[Вызовы.Количество() - 1].Аргументы;
        НомерОпции = Аргументы.Найти("--engine");
        Утверждения.ПроверитьРавенство(Истина, НомерОпции <> Неопределено);
        Утверждения.ПроверитьРавенство(Движок, Аргументы[НомерОпции + 1]);
    КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОбновитьСтаройВерсиейDeposБезДвижка() Экспорт

    // Подготовка
    Исполнитель = Новый ФиктивныйИсполнительОбновления;
    Параметры = Новый ПараметрыСредыAction;
    Параметры.ВерсияDepos = "0.7.0";
    Параметры.Манифест = "packagedef";
    Команда = Новый КомандаОбновленияЗависимостей(Исполнитель, Параметры);

    // Действие
    Команда.ВыполнитьКоманду(Неопределено);

    // Проверка
    Вызовы = Исполнитель.Вызовы();
    Утверждения.ПроверитьРавенство("depos@0.7.0", Вызовы[1].Аргументы[1]);
    Утверждения.ПроверитьРавенство("depos", Вызовы[2].Имя);
    Утверждения.ПроверитьРавенство(Неопределено, Вызовы[2].Аргументы.Найти("--engine"));

КонецПроцедуры

#КонецОбласти
