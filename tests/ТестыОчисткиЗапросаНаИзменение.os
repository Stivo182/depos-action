#Область Тесты

&Тест
Процедура ТестДолжен_СохранитьВеткуБезPullRequest() Экспорт

    // Подготовка
    Исполнитель = Новый ФиктивныйИсполнительGitHub("[]");
    Команда = КомандаОчистки(Исполнитель);

    // Действие
    Команда.ВыполнитьКоманду(Неопределено);

    // Проверка
    Утверждения.ПроверитьРавенство(1, Исполнитель.Вызовы().Количество());
    ПроверитьПоискБезОграниченияБазы(Исполнитель.Вызовы()[0]);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьВеткуПриPullRequestВДругуюБазу() Экспорт

    // Подготовка
    Список = "[{""number"":1,""body"":""<!-- depos-action: managed pull request -->""," +
        """baseRefName"":""develop"",""isCrossRepository"":false}]";
    Исполнитель = Новый ФиктивныйИсполнительGitHub(Список);
    Команда = КомандаОчистки(Исполнитель);

    // Действие
    Команда.ВыполнитьКоманду(Неопределено);

    // Проверка
    Утверждения.ПроверитьРавенство(1, Исполнитель.Вызовы().Количество());
    ПроверитьПоискБезОграниченияБазы(Исполнитель.Вызовы()[0]);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеЗакрытьPullRequestИзФоркаСПохожимИменемВетки() Экспорт

    // Подготовка
    Список = "[{""number"":3,""body"":""<!-- depos-action: managed pull request -->""," +
        """baseRefName"":""main"",""isCrossRepository"":true}]";
    Исполнитель = Новый ФиктивныйИсполнительGitHub(Список);
    Команда = КомандаОчистки(Исполнитель);

    // Действие
    Команда.ВыполнитьКоманду(Неопределено);

    // Проверка
    Утверждения.ПроверитьРавенство(1, Исполнитель.Вызовы().Количество());

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеЗакрытьPullRequestБезМаркера() Экспорт

    // Подготовка
    Список = "[{""number"":4,""body"":""ручной PR"",""baseRefName"":""main"",""isCrossRepository"":false}]";
    Исполнитель = Новый ФиктивныйИсполнительGitHub(Список);
    Команда = КомандаОчистки(Исполнитель);

    // Действие
    Команда.ВыполнитьКоманду(Неопределено);

    // Проверка
    Утверждения.ПроверитьРавенство(1, Исполнитель.Вызовы().Количество());

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗакрытьУправляемыйPullRequestИУдалитьЕгоВетку() Экспорт

    // Подготовка
    Список = "[{""number"":7,""body"":""<!-- depos-action: managed pull request -->""," +
        """baseRefName"":""main"",""isCrossRepository"":false}]";
    Исполнитель = Новый ФиктивныйИсполнительGitHub(Список);
    Команда = КомандаОчистки(Исполнитель);

    // Действие
    Команда.ВыполнитьКоманду(Неопределено);

    // Проверка
    Утверждения.ПроверитьРавенство(2, Исполнитель.Вызовы().Количество());
    Утверждения.ПроверитьРавенство("close", Исполнитель.Вызовы()[1][1]);
    Утверждения.ПроверитьРавенство(Истина, Исполнитель.Вызовы()[1].Найти("--delete-branch") <> Неопределено);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьВеткуДругогоPullRequestПриЗакрытииУправляемого() Экспорт

    // Подготовка
    Список = "[{""number"":7,""body"":""<!-- depos-action: managed pull request -->""," +
        """baseRefName"":""main"",""isCrossRepository"":false}," +
        "{""number"":8,""body"":""чужой"",""baseRefName"":""develop"",""isCrossRepository"":false}]";
    Исполнитель = Новый ФиктивныйИсполнительGitHub(Список);
    Команда = КомандаОчистки(Исполнитель);

    // Действие
    Команда.ВыполнитьКоманду(Неопределено);

    // Проверка
    Утверждения.ПроверитьРавенство(2, Исполнитель.Вызовы().Количество());
    Утверждения.ПроверитьРавенство("close", Исполнитель.Вызовы()[1][1]);
    Утверждения.ПроверитьРавенство(Неопределено, Исполнитель.Вызовы()[1].Найти("--delete-branch"));

КонецПроцедуры

&Тест
Процедура ТестДолжен_СообщитьОбОшибкеGitHubБезУдаленияВетки() Экспорт

    // Подготовка
    Исполнитель = Новый ФиктивныйИсполнительGitHub("ошибка API", 1);
    Команда = КомандаОчистки(Исполнитель);

    // Действие и Проверка
    ОшибкаВозникла = Ложь;
    Попытка
        Команда.ВыполнитьКоманду(Неопределено);
    Исключение
        ОшибкаВозникла = Истина;
    КонецПопытки;
    Утверждения.ПроверитьРавенство(Истина, ОшибкаВозникла);
    Утверждения.ПроверитьРавенство(1, Исполнитель.Вызовы().Количество());

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КомандаОчистки(Исполнитель)

    Параметры = Новый ПараметрыСредыAction;
    Параметры.Ветка = "depos/bump-deps/latest";
    Параметры.База = "main";
    Клиент = Новый КлиентЗапросовНаИзменениеGitHub(Исполнитель);
    Возврат Новый КомандаОчисткиЗапросаНаИзменение(Клиент, Параметры);

КонецФункции

Процедура ПроверитьПоискБезОграниченияБазы(Аргументы)

    Утверждения.ПроверитьРавенство(Неопределено, Аргументы.Найти("--base"));
    Утверждения.ПроверитьРавенство("depos/bump-deps/latest", Аргументы[3]);

КонецПроцедуры

#КонецОбласти
