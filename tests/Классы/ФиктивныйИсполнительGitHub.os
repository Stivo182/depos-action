Перем _Список;
Перем _КодВозврата;
Перем _Вызовы;
Перем _ОтветСсылки;

#Область ПрограммныйИнтерфейс

// Создает исполнитель gh с заданным ответом на запрос списка Pull Request.
//
// Параметры:
//   Список - Строка - Ответ gh pr list в формате JSON.
//   КодВозврата - Число - Код завершения gh pr list.
//   ОтветСсылки - Строка - Ответ gh api graphql при проверке ветки.
Процедура ПриСозданииОбъекта(Список, КодВозврата = 0, ОтветСсылки = "")

    _Список = Список;
    _КодВозврата = КодВозврата;
    _Вызовы = Новый Массив;
    _ОтветСсылки = ОтветСсылки;

КонецПроцедуры

// Возвращает зафиксированные вызовы gh.
//
// Возвращаемое значение:
//   Массив - Аргументы каждого вызова.
Функция Вызовы() Экспорт

    Возврат _Вызовы;

КонецФункции

// Выполняет заданный сценарий gh и фиксирует переданные аргументы.
//
// Параметры:
//   Имя - Строка - Имя запускаемой команды.
//   Аргументы - Массив - Аргументы gh.
//
// Возвращаемое значение:
//   Структура - КодВозврата и Вывод.
//
// Исключения:
//   Вызывает исключение при непредусмотренном вызове.
Функция ИсполнитьКоманду(Имя, Аргументы) Экспорт

    Если Имя <> "gh" Тогда
        ВызватьИсключение "Ожидался вызов gh";
    КонецЕсли;

    _Вызовы.Добавить(Аргументы);

    Если Аргументы[0] = "pr" И Аргументы[1] = "list" Тогда
        Возврат Новый Структура("КодВозврата,Вывод", _КодВозврата, _Список);
    ИначеЕсли Аргументы[0] = "pr" И Аргументы[1] = "close" Тогда
        Возврат Новый Структура("КодВозврата,Вывод", 0, "");
    ИначеЕсли Аргументы[0] = "api" Тогда
        Возврат Новый Структура("КодВозврата,Вывод", _КодВозврата, _ОтветСсылки);
    КонецЕсли;

    ВызватьИсключение "Непредусмотренный вызов gh";

КонецФункции

#КонецОбласти
