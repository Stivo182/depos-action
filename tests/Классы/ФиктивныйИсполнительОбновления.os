Перем _Вызовы;

#Область ПрограммныйИнтерфейс

// Создает исполнитель команд для проверки аргументов обновления.
Процедура ПриСозданииОбъекта()

    _Вызовы = Новый Массив;

КонецПроцедуры

// Возвращает записанные вызовы команд.
//
// Возвращаемое значение:
//   Массив - Имя и аргументы каждого вызова.
Функция Вызовы() Экспорт

    Возврат _Вызовы;

КонецФункции

// Сообщает CLI платформу для выбора пути отчета.
//
// Возвращаемое значение:
//   Булево - Ложь для проверки без преобразования пути.
Функция ЭтоWindows() Экспорт

    Возврат Ложь;

КонецФункции

// Записывает вызов и возвращает успешное выполнение.
//
// Параметры:
//   Имя - Строка - Имя команды.
//   Аргументы - Массив - Аргументы команды.
//   Выводить - Булево - Признак немедленного вывода.
//
// Возвращаемое значение:
//   Структура - КодВозврата и Вывод.
Функция ИсполнитьКоманду(Имя, Аргументы, Выводить = Ложь) Экспорт

    _Вызовы.Добавить(Новый Структура("Имя,Аргументы", Имя, Аргументы));

    Если Имя = "opm" И Аргументы[0] = "-v" Тогда
        Возврат Новый Структура("КодВозврата,Вывод", 0, "opm 1.3.0");
    КонецЕсли;

    Возврат Новый Структура("КодВозврата,Вывод", 0, "");

КонецФункции

#КонецОбласти
