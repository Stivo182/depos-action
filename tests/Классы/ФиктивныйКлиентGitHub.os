Перем _Репозитории;
Перем _Теги;
Перем _Сравнения;
Перем _Релизы;
Перем _Файлы;

#Область ПрограммныйИнтерфейс

Процедура ПриСозданииОбъекта()

    _Репозитории = Новый Соответствие;
    _Теги = Новый Соответствие;
    _Сравнения = Новый Соответствие;
    _Релизы = Новый Соответствие;
    _Файлы = Новый Соответствие;

КонецПроцедуры

Процедура ДобавитьФайл(Репозиторий, Путь, Тег, Текст) Экспорт

    _Файлы.Вставить(КлючФайла(Репозиторий, Путь, Тег), Текст);

КонецПроцедуры

Процедура ДобавитьРепозиторий(
    Имя,
    ЭтоФорк = Ложь,
    Родитель = "",
    Источник = "",
    Архивирован = Ложь,
    Обновлен = ""
) Экспорт

    _Репозитории.Вставить(Имя, Новый Структура(
        "ПолноеИмя,URL,ЭтоФорк,Родитель,Источник,Архивирован,Отключен,Обновлен",
        Имя,
        "https://github.com/" + Имя,
        ЭтоФорк,
        Родитель,
        Источник,
        Архивирован,
        Ложь,
        Обновлен
    ));

КонецПроцедуры

Процедура ДобавитьТег(Репозиторий, Версия, Тег) Экспорт

    _Теги.Вставить(Репозиторий + "@" + Версия, Тег);

КонецПроцедуры

Процедура ДобавитьСравнение(Репозиторий, ТегДо, ТегПосле) Экспорт

    Ключ = Репозиторий + "@" + ТегДо + "..." + ТегПосле;
    _Сравнения.Вставить(Ключ, Новый Структура(
        "URL,Коммиты",
        "https://github.com/" + Репозиторий + "/compare/" + ТегДо + "..." + ТегПосле,
        Новый Массив
    ));

КонецПроцедуры

Процедура ДобавитьКоммит(Репозиторий, ТегДо, ТегПосле, SHA, Сообщение) Экспорт

    Ключ = Репозиторий + "@" + ТегДо + "..." + ТегПосле;
    Сравнение = _Сравнения.Получить(Ключ);
    Сравнение.Коммиты.Добавить(Новый Структура(
        "sha,html_url,commit",
        SHA,
        "https://github.com/" + Репозиторий + "/commit/" + SHA,
        Новый Структура("message", Сообщение)
    ));

КонецПроцедуры

Процедура ДобавитьРелиз(Репозиторий, Тег, Название, Текст, Черновик = Ложь, Предрелиз = Ложь) Экспорт

    Релизы = _Релизы.Получить(Репозиторий);
    Если Релизы = Неопределено Тогда
        Релизы = Новый Массив;
        _Релизы.Вставить(Репозиторий, Релизы);
    КонецЕсли;
    Релизы.Добавить(Новый Структура(
        "tag_name,name,body,html_url,draft,prerelease",
        Тег,
        Название,
        Текст,
        "https://github.com/" + Репозиторий + "/releases/tag/" + Тег,
        Черновик,
        Предрелиз
    ));

КонецПроцедуры

Функция ПолучитьРепозиторий(ПолноеИмя) Экспорт

    Возврат _Репозитории.Получить(ПолноеИмя);

КонецФункции

Функция РазрешитьТег(ПолноеИмя, Версия) Экспорт

    Возврат _Теги.Получить(ПолноеИмя + "@" + Версия);

КонецФункции

Функция Сравнить(ПолноеИмя, ТегДо, ТегПосле) Экспорт

    Возврат _Сравнения.Получить(ПолноеИмя + "@" + ТегДо + "..." + ТегПосле);

КонецФункции

Функция ПолучитьРелизы(ПолноеИмя) Экспорт

    Результат = _Релизы.Получить(ПолноеИмя);
    Возврат ?(Результат = Неопределено, Новый Массив, Результат);

КонецФункции

Функция ПолучитьФайл(ПолноеИмя, Путь, Тег) Экспорт

    Результат = _Файлы.Получить(КлючФайла(ПолноеИмя, Путь, Тег));
    Возврат ?(Результат = Неопределено, "", Результат);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КлючФайла(Репозиторий, Путь, Тег)

    Возврат Репозиторий + ":" + Путь + "@" + Тег;

КонецФункции

#КонецОбласти
