&Тест
Процедура ТестДолжен_ОтклонитьОбщуюВеткуДвухPullRequest() Экспорт

    // Подготовка
    Список = "[{""body"":""<!-- depos-action: managed pull request -->""," +
        """baseRefName"":""main"",""isCrossRepository"":false}," +
        "{""body"":""ручной PR"",""baseRefName"":""develop"",""isCrossRepository"":false}]";
    Исполнитель = Новый ФиктивныйИсполнительGitHub(Список, 0, ОтветСуществующейВетки());
    Команда = КомандаПроверки(Исполнитель);

    // Действие
    Ошибка = ОшибкаПроверки(Команда);

    // Проверка
    Ожидаем.Что(Ошибка).Содержит("не принадлежит единственному открытому Pull Request depos-action");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьВеткуПриОшибкеGitHub() Экспорт

    // Подготовка
    Исполнитель = Новый ФиктивныйИсполнительGitHub("[]", 1);
    Команда = КомандаПроверки(Исполнитель);

    // Действие
    Ошибка = ОшибкаПроверки(Команда);

    // Проверка
    Ожидаем.Что(Ошибка).Содержит("gh завершился с кодом 1");
    Утверждения.ПроверитьРавенство(1, Исполнитель.Вызовы().Количество());

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьНекорректныйОтветGitHub() Экспорт

    // Подготовка
    Ответ = "{""data"":{""repository"":{""ref"":{""name"":""другая-ветка"",""prefix"":""refs/heads/""}}}}";
    Исполнитель = Новый ФиктивныйИсполнительGitHub("[]", 0, Ответ);
    Команда = КомандаПроверки(Исполнитель);

    // Действие
    Ошибка = ОшибкаПроверки(Команда);

    // Проверка
    Ожидаем.Что(Ошибка).Содержит("некорректную ссылку ветки");
    Утверждения.ПроверитьРавенство(1, Исполнитель.Вызовы().Количество());

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КомандаПроверки(Исполнитель, Ветка = "depos/bump-deps/latest")

    Параметры = Новый ПараметрыСредыAction;
    Параметры.Ветка = Ветка;
    Параметры.База = "main";
    Параметры.РепозиторийGitHub = "owner/repo";
    Клиент = Новый КлиентЗапросовНаИзменениеGitHub(Исполнитель);
    Возврат Новый КомандаПроверкиВеткиЗапросаНаИзменение(Клиент, Параметры);

КонецФункции

Функция ОшибкаПроверки(Команда)

    Попытка
        Команда.ВыполнитьКоманду(Неопределено);
    Исключение
        Возврат ОписаниеОшибки();
    КонецПопытки;

    Возврат "";

КонецФункции

Функция ОтветСуществующейВетки()

    Возврат "{""data"":{""repository"":{""ref"":{""name"":""depos/bump-deps/latest"",""prefix"":""refs/heads/""}}}}";

КонецФункции

#КонецОбласти
