#Область Тесты

&Тест
Процедура ТестДолжен_РазрешитьСозданиеСвободнойВетки() Экспорт

    // Подготовка
    Исполнитель = Новый ФиктивныйИсполнительGitHub("[]", 0, "{""data"":{""repository"":{""ref"":null}}}");
    Команда = КомандаПроверки(Исполнитель);

    // Действие
    Команда.ВыполнитьКоманду(Неопределено);

    // Проверка
    Утверждения.ПроверитьРавенство(1, Исполнитель.Вызовы().Количество());
    Утверждения.ПроверитьРавенство("graphql", Исполнитель.Вызовы()[0][1]);
    Утверждения.ПроверитьРавенство("ref=refs/heads/depos/bump-deps/latest", Исполнитель.Вызовы()[0][9]);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПередатьОсобоеИмяВеткиКакЗначениеGraphQL() Экспорт

    // Подготовка
    Исполнитель = Новый ФиктивныйИсполнительGitHub("[]", 0, "{""data"":{""repository"":{""ref"":null}}}");
    Команда = КомандаПроверки(Исполнитель, "depos/bump#deps/%latest");

    // Действие
    Команда.ВыполнитьКоманду(Неопределено);

    // Проверка
    Утверждения.ПроверитьРавенство("ref=refs/heads/depos/bump#deps/%latest", Исполнитель.Вызовы()[0][9]);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьЗанятуюВеткуБезPullRequest() Экспорт

    // Подготовка
    Исполнитель = Новый ФиктивныйИсполнительGitHub("[]", 0, ОтветСуществующейВетки());
    Команда = КомандаПроверки(Исполнитель);

    // Действие
    Ошибка = ОшибкаПроверки(Команда);

    // Проверка
    Ожидаем.Что(Ошибка).Содержит("Ветка depos/bump-deps/latest уже существует");
    Утверждения.ПроверитьРавенство(2, Исполнитель.Вызовы().Количество());
    Утверждения.ПроверитьРавенство(Неопределено, Исполнитель.Вызовы()[1].Найти("--base"));

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазрешитьОбновлениеУправляемогоPullRequest() Экспорт

    // Подготовка
    Список = "[{""body"":""<!-- depos-action: managed pull request -->""," +
        """baseRefName"":""main"",""isCrossRepository"":false}]";
    Исполнитель = Новый ФиктивныйИсполнительGitHub(Список, 0, ОтветСуществующейВетки());
    Команда = КомандаПроверки(Исполнитель);

    // Действие
    Команда.ВыполнитьКоманду(Неопределено);

    // Проверка
    Утверждения.ПроверитьРавенство(2, Исполнитель.Вызовы().Количество());

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьЧужойPullRequest() Экспорт

    // Подготовка
    Список = "[{""body"":""ручной PR"",""baseRefName"":""main"",""isCrossRepository"":false}]";
    Исполнитель = Новый ФиктивныйИсполнительGitHub(Список, 0, ОтветСуществующейВетки());
    Команда = КомандаПроверки(Исполнитель);

    // Действие
    Ошибка = ОшибкаПроверки(Команда);

    // Проверка
    Ожидаем.Что(Ошибка).Содержит("не принадлежит единственному открытому Pull Request depos-action");

КонецПроцедуры

