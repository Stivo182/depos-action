#Использовать url

#Область ПрограммныйИнтерфейс

// Очищает внешний Markdown перед включением в описание Pull Request.
//
// Параметры:
//   Текст - Строка - Недоверенный Markdown.
//   БазовыйURL - Строка - URL репозитория для относительных ссылок.
//
// Возвращаемое значение:
//   Строка - Очищенный Markdown.
Функция ОчиститьВнешнийТекст(Текст, БазовыйURL = "") Экспорт

    Результат = СтрЗаменить(Текст, Символы.ВК, "");
    Результат = СтрЗаменить(Результат, "@", "@" + Символ(8203));
    Результат = СтрЗаменить(Результат, "<", "&lt;");
    Результат = ИсправитьОтносительныеСсылки(Результат, БазовыйURL);

    Возврат Результат;

КонецФункции

// Очищает текст и разрешает относительные ссылки по тегу.
//
// Параметры:
//   Текст - Строка - Недоверенный Markdown.
//   URLРепозитория - Строка - URL репозитория.
//   Тег - Строка - Тег релиза.
//
// Возвращаемое значение:
//   Строка - Очищенный Markdown с абсолютными ссылками на файлы тега.
Функция ОчиститьТекстПоТегу(Текст, URLРепозитория, Тег) Экспорт

    Возврат ОчиститьВнешнийТекст(Текст, БазовыйURLТега(URLРепозитория, Тег));

КонецФункции

// Экранирует недоверенный текст для использования как подпись Markdown-ссылки.
//
// Параметры:
//   Текст - Строка - Исходная подпись.
//
// Возвращаемое значение:
//   Строка - Однострочная безопасная подпись.
Функция ЭкранироватьТекстСсылки(Текст) Экспорт

    Результат = ЭкранироватьЯчейку(ОчиститьВнешнийТекст(Текст));
    Результат = СтрЗаменить(Результат, "\", "\\");
    Результат = СтрЗаменить(Результат, "[", "\[");
    Возврат СтрЗаменить(Результат, "]", "\]");

КонецФункции

// Ограничивает текст заданным количеством строк.
//
// Параметры:
//   Текст - Строка - Исходный текст.
//   Лимит - Число - Максимальное число строк.
//
// Возвращаемое значение:
//   Структура - Поля Текст и Сокращен.
Функция ОграничитьСтроки(Текст, Лимит) Экспорт

    Строки = СтрРазделить(СтрЗаменить(Текст, Символы.ВК, ""), Символы.ПС, Истина);
    Сокращен = Строки.Количество() > Лимит;
    Результат = Новый Массив;
    ПоследнийИндекс = Мин(Строки.Количество(), Лимит) - 1;

    Для Индекс = 0 По ПоследнийИндекс Цикл
        Результат.Добавить(Строки[Индекс]);
    КонецЦикла;

    Возврат Новый Структура("Текст,Сокращен", СтрСоединить(Результат, Символы.ПС), Сокращен);

КонецФункции

// Экранирует значение ячейки Markdown-таблицы.
//
// Параметры:
//   Значение - Строка - Значение ячейки.
//
// Возвращаемое значение:
//   Строка - Однострочное экранированное значение.
Функция ЭкранироватьЯчейку(Значение) Экспорт

    Результат = СтрЗаменить(Значение, Символы.ВК, "");
    Результат = СтрЗаменить(Результат, Символы.ПС, " ");
    Возврат СтрЗаменить(Результат, "|", "\|");

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция БазовыйURLТега(URLРепозитория, Тег)

    Если ПустаяСтрока(Тег) Тогда
        Возврат URLРепозитория;
    КонецЕсли;

    Попытка
        Возврат Новый URL(URLРепозитория + "/").Разрешить("blob/" + Тег + "/").ВСтроку();
    Исключение
        Возврат URLРепозитория;
    КонецПопытки;

КонецФункции

Функция ИсправитьОтносительныеСсылки(Текст, БазовыйURL)

    Если ПустаяСтрока(БазовыйURL) Тогда
        Возврат Текст;
    КонецЕсли;

    База = ?(Прав(БазовыйURL, 1) = "/", БазовыйURL, БазовыйURL + "/");
    Фрагменты = Новый Массив;
    Остаток = Текст;

    Пока Истина Цикл
        НачалоСсылки = СтрНайти(Остаток, "](");

        Если НачалоСсылки = 0 Тогда
            Фрагменты.Добавить(Остаток);
            Прервать;
        КонецЕсли;

        Фрагменты.Добавить(Лев(Остаток, НачалоСсылки + 1));

        ПослеНачала = Сред(Остаток, НачалоСсылки + 2);
        КонецСсылки = НайтиКонецMarkdownСсылки(ПослеНачала);

        Если КонецСсылки = 0 Тогда
            Фрагменты.Добавить(ПослеНачала);
            Прервать;
        КонецЕсли;

        Назначение = РазобратьНазначениеСсылки(Лев(ПослеНачала, КонецСсылки - 1));
        Фрагменты.Добавить(
            РазрешитьОтносительныйАдрес(Назначение.Адрес, База)
            + Назначение.Суффикс
            + ")"
        );
        Остаток = Сред(ПослеНачала, КонецСсылки + 1);
    КонецЦикла;

    Возврат СтрСоединить(Фрагменты, "");

КонецФункции

Функция НайтиКонецMarkdownСсылки(Текст)

    Глубина = 0;
    Кавычка = "";
    Экранирован = Ложь;

    Для Индекс = 1 По СтрДлина(Текст) Цикл
        СимволТекста = Сред(Текст, Индекс, 1);

        Если Экранирован Тогда
            Экранирован = Ложь;
            Продолжить;
        КонецЕсли;

        Если СимволТекста = "\" Тогда
            Экранирован = Истина;
            Продолжить;
        КонецЕсли;

        Если Не ПустаяСтрока(Кавычка) Тогда
            Если СимволТекста = Кавычка Тогда
                Кавычка = "";
            КонецЕсли;
            Продолжить;
        КонецЕсли;

        Если СимволТекста = """" Или СимволТекста = "'" Тогда
            Кавычка = СимволТекста;
        ИначеЕсли СимволТекста = "(" Тогда
            Глубина = Глубина + 1;
        ИначеЕсли СимволТекста = ")" Тогда
            Если Глубина = 0 Тогда
                Возврат Индекс;
            КонецЕсли;
            Глубина = Глубина - 1;
        КонецЕсли;
    КонецЦикла;

    Возврат 0;

КонецФункции

Функция РазобратьНазначениеСсылки(Текст)

    ПозицияПробела = СтрНайти(Текст, " ");
    ПозицияТабуляции = СтрНайти(Текст, Символы.Таб);

    Если ПозицияПробела = 0
        Или (ПозицияТабуляции > 0 И ПозицияТабуляции < ПозицияПробела) Тогда
        ПозицияРазделителя = ПозицияТабуляции;
    Иначе
        ПозицияРазделителя = ПозицияПробела;
    КонецЕсли;

    Если ПозицияРазделителя = 0 Тогда
        Возврат Новый Структура("Адрес,Суффикс", Текст, "");
    КонецЕсли;

    Возврат Новый Структура(
        "Адрес,Суффикс",
        Лев(Текст, ПозицияРазделителя - 1),
        Сред(Текст, ПозицияРазделителя)
    );

КонецФункции

Функция РазрешитьОтносительныйАдрес(Адрес, База)

    Если ПустаяСтрока(Адрес)
        Или Лев(Адрес, 1) = "#"
        Или СтрНайти(Адрес, ":") > 0 Тогда
        Возврат Адрес;
    КонецЕсли;

    Попытка
        Возврат Новый URL(Адрес, База).ВСтроку();
    Исключение
        Возврат Адрес;
    КонецПопытки;

КонецФункции

#КонецОбласти
