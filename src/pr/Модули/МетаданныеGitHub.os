#Область ПрограммныйИнтерфейс

// Дополняет обновления метаданными GitHub.
//
// Параметры:
//   Обновления - Массив из Структура - Нормализованные обновления depos.
//   Токен - Строка - Токен GitHub.
//
// Возвращаемое значение:
//   Массив из Структура - Обновления с метаданными GitHub.
Функция ОбогатитьВсе(Обновления, Токен) Экспорт

    Клиент = Новый КлиентGitHub("https://api.github.com", Токен);
    Определитель = Новый ОпределительРепозитория(Клиент);
    Сборщик = Новый СборщикМетаданныхОбновления(Определитель, Клиент);

    Возврат Сборщик.ОбогатитьВсе(Обновления);

КонецФункции

#КонецОбласти
