#Область ПрограммныйИнтерфейс

// Формирует заголовок и тело Pull Request.
//
// Параметры:
//   Обновления - Массив из Структура - Обновления зависимостей с необязательными метаданными.
//   Префикс - Строка - Префикс заголовка.
//   Файл - Строка - Изменённый manifest.
//   Стратегия - Строка - Стратегия depos: latest, minor или patch.
//
// Возвращаемое значение:
//   Структура - Поля Заголовок и Тело.
Функция Сформировать(Обновления, Префикс, Файл, Стратегия) Экспорт

    Заголовок = СформироватьЗаголовок(Обновления, Префикс);
    Отсортированные = ОтсортироватьДляТаблицы(Обновления);
    Подвал = СтрШаблон(
        "<sub>Created automatically by [depos-action](https://github.com/Stivo182/depos-action) · file _%1_</sub>",
        БезопасныйMarkdown.ЭкранироватьЯчейку(Файл)
    );
    СообщениеСокращения = "_Additional dependency details were truncated._";
    РезервПодвала = СтрДлина(СообщениеСокращения) + СтрДлина(Подвал) + 4;
    ЗаголовочнаяЧасть = СформироватьЗаголовочнуюЧасть(
        Отсортированные,
        Стратегия,
        60000 - РезервПодвала
    );

    СтрокиТела = ЗаголовочнаяЧасть.Строки;
    ДлинаТела = ЗаголовочнаяЧасть.Длина;
    ПодробностиСокращены = Ложь;

    Если ЗаголовочнаяЧасть.КоличествоОбновлений > 0 Тогда
        Для Индекс = 0 По ЗаголовочнаяЧасть.КоличествоОбновлений - 1 Цикл
            Блок = СформироватьПодробности(Отсортированные[Индекс]);
            Если ПустаяСтрока(Блок) Тогда
                Продолжить;
            КонецЕсли;

            ИтоговаяДлина = ДлинаТела
                + СтрДлина(Блок)
                + РезервПодвала
                + 4;

            Если ИтоговаяДлина <= 60000 Тогда
                ДобавитьБлок(СтрокиТела, Блок);
                ДлинаТела = ДлинаТела + СтрДлина(Блок) + 2;
            Иначе
                ПодробностиСокращены = Истина;
            КонецЕсли;
        КонецЦикла;
    КонецЕсли;

    Если ПодробностиСокращены Тогда
        ДобавитьБлок(СтрокиТела, СообщениеСокращения);
    КонецЕсли;

    ДобавитьБлок(СтрокиТела, Подвал);

    Возврат Новый Структура("Заголовок,Тело", Заголовок, СтрСоединить(СтрокиТела, Символы.ПС));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СформироватьЗаголовок(Обновления, Префикс)

    Части = Новый Массив;
    ПоследнийИндекс = Мин(Обновления.Количество(), 2) - 1;
    Для Индекс = 0 По ПоследнийИндекс Цикл
        Обновление = Обновления[Индекс];
        Части.Добавить(СтрШаблон(
            "%1 %2 → %3",
            Обновление.ИмяПакета,
            Обновление.ВерсияДо,
            Обновление.ВерсияПосле
        ));
    КонецЦикла;

    Результат = "Bump " + СтрСоединить(Части, ", ");
    Осталось = Обновления.Количество() - 2;
    Если Осталось > 0 Тогда
        Результат = Результат + СтрШаблон(
            " and %1 more package%2",
            Осталось,
            ?(Осталось > 1, "s", "")
        );
    КонецЕсли;

    Если Не ПустаяСтрока(Префикс) Тогда
        Результат = Префикс + ": " + Результат;
    КонецЕсли;

    Возврат Результат;

КонецФункции

Функция СформироватьЗаголовочнуюЧасть(Обновления, Стратегия, МаксимальнаяДлина)

    Строки = Новый Массив;
    Строки.Добавить("<!-- depos-action: managed pull request -->");
    Строки.Добавить("");
    Строки.Добавить("## 📦 Dependency updates");
    Строки.Добавить("");
    Строки.Добавить(СтрШаблон("Updated packages: **%1** · Strategy: `%2`", Обновления.Количество(), Стратегия));
    Строки.Добавить("");
    Строки.Добавить("| Dependency | Update | Type | Links |");
    Строки.Добавить("|---|:---:|:---:|---|");

    Длина = СтрДлина(СтрСоединить(Строки, Символы.ПС));
    КоличествоОбновлений = 0;
    СообщениеСокращения = "_Additional dependency rows were truncated._";

    Для Индекс = 0 По Обновления.Количество() - 1 Цикл
        Обновление = Обновления[Индекс];
        СтандартныеСсылки = СсылкиПакета.Получить(Обновление.ИмяПакета);
        URLРепозитория = ПолучитьПоле(Обновление, "URLРепозитория", СтандартныеСсылки.URLРепозитория);
        URLHub = ПолучитьПоле(Обновление, "URLHub", СтандартныеСсылки.URLHub);
        Тип = ?(Обновление.Тип = "major", "⚠️ major", Обновление.Тип);
        Ссылки = СформироватьСсылки(Обновление, URLHub, URLРепозитория);

        СтрокаОбновления = СтрШаблон(
            "| [%1](%2) | `%3` → `%4` | %5 | %6 |",
            БезопасныйMarkdown.ЭкранироватьЯчейку(Обновление.ИмяПакета),
            URLРепозитория,
            Обновление.ВерсияДо,
            Обновление.ВерсияПосле,
            Тип,
            Ссылки
        );

        РезервСокращения = ?(
            Индекс < Обновления.Количество() - 1,
            СтрДлина(СообщениеСокращения) + 2,
            0
        );

        НоваяДлина = Длина
            + 1
            + СтрДлина(СтрокаОбновления)
            + РезервСокращения;

        Если НоваяДлина > МаксимальнаяДлина Тогда
            ДобавитьБлок(Строки, СообщениеСокращения);
            Прервать;
        КонецЕсли;

        Строки.Добавить(СтрокаОбновления);
        Длина = Длина + СтрДлина(СтрокаОбновления) + 1;
        КоличествоОбновлений = КоличествоОбновлений + 1;
    КонецЦикла;

    Возврат Новый Структура(
        "Строки,Длина,КоличествоОбновлений",
        Строки,
        Длина,
        КоличествоОбновлений
    );

КонецФункции

Функция СформироватьСсылки(Обновление, URLHub, URLРепозитория)

    Части = Новый Массив;
    Части.Добавить(СтрШаблон("[Hub](%1)", URLHub));

    Релизы = ПолучитьПоле(Обновление, "Релизы", Новый Массив);
    Если Релизы.Количество() > 0 И Не ПустаяСтрока(URLРепозитория) Тогда
        Разделитель = ?(Прав(URLРепозитория, 1) = "/", "", "/");
        Части.Добавить(СтрШаблон("[Releases](%1%2releases)", URLРепозитория, Разделитель));
    КонецЕсли;

    URLСравнения = ПолучитьПоле(Обновление, "URLСравнения", "");
    Если Не ПустаяСтрока(URLСравнения) Тогда
        Части.Добавить(СтрШаблон("[Compare](%1)", URLСравнения));
    КонецЕсли;

    Возврат СтрСоединить(Части, " · ");

КонецФункции

Процедура ДобавитьБлок(Строки, Блок)

    Строки.Добавить("");
    Строки.Добавить(Блок);

КонецПроцедуры

Функция СформироватьПодробности(Обновление)

    Релизы = ПолучитьПоле(Обновление, "Релизы", Новый Массив);
    Коммиты = ПолучитьПоле(Обновление, "Коммиты", Новый Массив);

    Если Релизы.Количество() = 0 И Коммиты.Количество() = 0 Тогда
        Возврат "";
    КонецЕсли;

    Строки = Новый Массив;
    Строки.Добавить(СтрШаблон("### %1", Обновление.ИмяПакета));
    Строки.Добавить("");
    Строки.Добавить(СтрШаблон("`%1` → `%2`", Обновление.ВерсияДо, Обновление.ВерсияПосле));

    Если Релизы.Количество() > 0 Тогда
        Строки.Добавить("");
        Строки.Добавить(СформироватьРелизы(Обновление, Релизы));
    КонецЕсли;

    Если Коммиты.Количество() > 0 Тогда
        Строки.Добавить("");
        Строки.Добавить(СформироватьКоммиты(Обновление, Коммиты));
    КонецЕсли;

    Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Функция СформироватьРелизы(Обновление, Релизы)

    URLРепозитория = ПолучитьПоле(Обновление, "URLРепозитория", "");
    ТекстРелизов = Новый Массив;

    Для Каждого Релиз Из Релизы Цикл
        Название = БезопасныйMarkdown.ЭкранироватьТекстСсылки(Релиз.Название);
        ТекстРелизов.Добавить(СтрШаблон("## [%1](%2)", Название, Релиз.URL));
        ТекстРелизов.Добавить(БезопасныйMarkdown.ОчиститьТекстРелиза(
            Релиз.Текст,
            URLРепозитория,
            ПолучитьПоле(Релиз, "Тег", "")
        ));
    КонецЦикла;

    Ограниченный = БезопасныйMarkdown.ОграничитьСтроки(СтрСоединить(ТекстРелизов, Символы.ПС), 50);

    Строки = Новый Массив;
    Строки.Добавить("<details>");
    Строки.Добавить("<summary>📋 Release notes</summary>");
    Строки.Добавить("");
    Строки.Добавить(СтрШаблон(
        "*Sourced from [%1's releases](%2/releases).*",
        Обновление.ИмяПакета,
        URLРепозитория
    ));
    Строки.Добавить("");

    Для Каждого СтрокаТекста Из СтрРазделить(Ограниченный.Текст, Символы.ПС, Истина) Цикл
        Строки.Добавить("> " + СтрокаТекста);
    КонецЦикла;

    Если Ограниченный.Сокращен Тогда
        Строки.Добавить("> ");
        Строки.Добавить("> ... (truncated)");
    КонецЕсли;

    Строки.Добавить("");
    Строки.Добавить("</details>");

    Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Функция СформироватьКоммиты(Обновление, Коммиты)

    Строки = Новый Массив;
    Строки.Добавить("<details>");
    Строки.Добавить("<summary>🔨 Commits</summary>");
    Строки.Добавить("");

    ПервыйИндекс = Макс(0, Коммиты.Количество() - 10);
    Индекс = Коммиты.Количество() - 1;

    Пока Индекс >= ПервыйИндекс Цикл
        Коммит = Коммиты[Индекс];
        Заголовок = ПерваяСтрока(Коммит.Сообщение);

        Если СтрДлина(Заголовок) > 80 Тогда
            Заголовок = Лев(Заголовок, 77) + "...";
        КонецЕсли;

        Заголовок = БезопасныйMarkdown.ОчиститьВнешнийТекст(Заголовок);
        Заголовок = УточнитьСсылкиGitHub(Заголовок, Коммит.URL);

        Строки.Добавить(СтрШаблон("- [`%1`](%2) %3", Лев(Коммит.SHA, 7), Коммит.URL, Заголовок));
        Индекс = Индекс - 1;
    КонецЦикла;

    URLСравнения = ПолучитьПоле(Обновление, "URLСравнения", "");
    Строки.Добавить("");
    Строки.Добавить(СтрШаблон("[View full comparison](%1)", URLСравнения));
    Строки.Добавить("");
    Строки.Добавить("</details>");

    Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Функция УточнитьСсылкиGitHub(Текст, URLКоммита)

    Репозиторий = ПолучитьРепозиторийGitHubИзURLКоммита(URLКоммита);
    Если ПустаяСтрока(Репозиторий) Тогда
        Возврат Текст;
    КонецЕсли;

    Результат = "";
    Позиция = 1;
    Пока Позиция <= СтрДлина(Текст) Цикл
        СимволТекста = Сред(Текст, Позиция, 1);
        Если СимволТекста = "#" И ЭтоНачалоСсылкиGitHub(Текст, Позиция) Тогда
            КонецНомера = Позиция + 1;
            Пока КонецНомера <= СтрДлина(Текст)
                И ЭтоЦифра(Сред(Текст, КонецНомера, 1)) Цикл
                КонецНомера = КонецНомера + 1;
            КонецЦикла;

            Если КонецНомера > Позиция + 1 И ЭтоКонецСсылкиGitHub(Текст, КонецНомера) Тогда
                Результат = Результат + Репозиторий + Лев(Сред(Текст, Позиция), КонецНомера - Позиция);
                Позиция = КонецНомера;
                Продолжить;
            КонецЕсли;
        КонецЕсли;

        Результат = Результат + СимволТекста;
        Позиция = Позиция + 1;
    КонецЦикла;

    Возврат Результат;

КонецФункции

Функция ЭтоКонецСсылкиGitHub(Текст, Позиция)

    Если Позиция > СтрДлина(Текст) Тогда
        Возврат Истина;
    КонецЕсли;

    Возврат Не ЭтоСимволИдентификатораGitHub(Сред(Текст, Позиция, 1));

КонецФункции

Функция ПолучитьРепозиторийGitHubИзURLКоммита(URLКоммита)

    МаркерGitHub = "github.com/";
    НачалоПути = СтрНайти(URLКоммита, МаркерGitHub);
    Если НачалоПути = 0 Тогда
        Возврат "";
    КонецЕсли;

    ЧастиПути = СтрРазделить(Сред(URLКоммита, НачалоПути + СтрДлина(МаркерGitHub)), "/");
    Если ЧастиПути.Количество() < 3 Или ЧастиПути[2] <> "commit" Тогда
        Возврат "";
    КонецЕсли;

    Возврат ЧастиПути[0] + "/" + ЧастиПути[1];

КонецФункции

Функция ЭтоНачалоСсылкиGitHub(Текст, Позиция)

    Если Позиция = 1 Тогда
        Возврат Истина;
    КонецЕсли;

    Возврат Не ЭтоСимволИдентификатораGitHub(Сред(Текст, Позиция - 1, 1));

КонецФункции

Функция ЭтоСимволИдентификатораGitHub(СимволТекста)

    Возврат СтрНайти("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_-./", СимволТекста) > 0;

КонецФункции

Функция ЭтоЦифра(СимволТекста)

    Возврат СтрНайти("0123456789", СимволТекста) > 0;

КонецФункции

Функция ПерваяСтрока(Текст)

    Строки = СтрРазделить(СтрЗаменить(Текст, Символы.ВК, ""), Символы.ПС, Истина);
    Возврат СокрЛП(Строки[0]);

КонецФункции

Функция ПолучитьПоле(Объект, Имя, ЗначениеПоУмолчанию)

    Значение = Неопределено;

    Если Объект.Свойство(Имя, Значение) Тогда
        Возврат Значение;
    КонецЕсли;

    Возврат ЗначениеПоУмолчанию;

КонецФункции

Функция ОтсортироватьДляТаблицы(Обновления)

    Таблица = Новый ТаблицаЗначений;
    Таблица.Колонки.Добавить("Вес");
    Таблица.Колонки.Добавить("ИмяПакета");
    Таблица.Колонки.Добавить("Обновление");

    Для Каждого Обновление Из Обновления Цикл
        СтрокаТаблицы = Таблица.Добавить();
        СтрокаТаблицы.Вес = ВесТипа(Обновление.Тип);
        СтрокаТаблицы.ИмяПакета = НРег(Обновление.ИмяПакета);
        СтрокаТаблицы.Обновление = Обновление;
    КонецЦикла;

    Таблица.Сортировать("Вес Убыв, ИмяПакета Возр");

    Результат = Новый Массив;
    Для Каждого СтрокаТаблицы Из Таблица Цикл
        Результат.Добавить(СтрокаТаблицы.Обновление);
    КонецЦикла;

    Возврат Результат;

КонецФункции

Функция ВесТипа(Тип)

    Если Тип = "major" Тогда
        Возврат 3;
    ИначеЕсли Тип = "minor" Тогда
        Возврат 2;
    Иначе
        Возврат 1;
    КонецЕсли;

КонецФункции

#КонецОбласти
