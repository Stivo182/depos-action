#Использовать 1connector
#Использовать url

Перем _АдресAPI;
Перем _Токен;
Перем _ОбработчикПредупреждения;
Перем _Транспорт;
Перем _ШаблонРепозитория;
Перем _ШаблонТега;
Перем _ШаблонСравнения;
Перем _ШаблонРелизов;
Перем _ШаблонСодержимого;
Перем _КэшJSON;
Перем _МаксимальноеКоличествоСтраницРелизов;

#Область ОбработчикиСобытий

Процедура ПриСозданииОбъекта(АдресAPI, Токен, ОбработчикПредупреждения = Неопределено, Транспорт = Неопределено)

    _АдресAPI = СокрП(АдресAPI);
    Пока Прав(_АдресAPI, 1) = "/" Цикл
        _АдресAPI = Лев(_АдресAPI, СтрДлина(_АдресAPI) - 1);
    КонецЦикла;

    _Токен = Токен;
    _ОбработчикПредупреждения = ОбработчикПредупреждения;
    _Транспорт = Транспорт;
    _ШаблонРепозитория = Новый ШаблонURI("/repos/{+full_name}");
    _ШаблонТега = Новый ШаблонURI("/repos/{+full_name}/git/ref/tags/{+tag}");
    _ШаблонСравнения = Новый ШаблонURI(
        "/repos/{+full_name}/compare/{+base}...{+head}{?per_page,page}"
    );
    _ШаблонРелизов = Новый ШаблонURI("/repos/{+full_name}/releases{?per_page,page}");
    _ШаблонСодержимого = Новый ШаблонURI("/repos/{+full_name}/contents/{+path}{?ref}");
    _КэшJSON = Новый Соответствие;
    _МаксимальноеКоличествоСтраницРелизов = 3;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Получает метаданные репозитория.
//
// Параметры:
//   ПолноеИмя - Строка - Репозиторий в формате owner/name.
//
// Возвращаемое значение:
//   Структура, Неопределено - Нормализованные метаданные либо Неопределено для недоступного репозитория.
Функция ПолучитьРепозиторий(ПолноеИмя) Экспорт

    Данные = ПолучитьJSON(РаскрытьШаблон(_ШаблонРепозитория, Новый Структура("full_name", ПолноеИмя)));
    Если Данные = Неопределено Тогда
        Возврат Неопределено;
    КонецЕсли;

    Родитель = ПолучитьВложенноеПоле(Данные, "parent", "full_name");
    Источник = ПолучитьВложенноеПоле(Данные, "source", "full_name");

    Возврат Новый Структура(
        "ПолноеИмя,URL,ЭтоФорк,Родитель,Источник,Архивирован,Отключен,Обновлен",
        ПолучитьПоле(Данные, "full_name"),
        ПолучитьПоле(Данные, "html_url"),
        ПолучитьПоле(Данные, "fork", Ложь),
        Родитель,
        Источник,
        ПолучитьПоле(Данные, "archived", Ложь),
        ПолучитьПоле(Данные, "disabled", Ложь),
        ПолучитьПоле(Данные, "pushed_at")
    );

КонецФункции

// Разрешает версию в существующий тег `version` или `vversion`.
Функция РазрешитьТег(ПолноеИмя, Версия) Экспорт

    Теги = Новый Массив;
    Теги.Добавить(Версия);
    Теги.Добавить("v" + Версия);
    Теги.Добавить("ver" + Версия);

    Для Каждого Тег Из Теги Цикл
        Данные = ПолучитьJSON(РаскрытьШаблон(_ШаблонТега, Новый Структура("full_name,tag", ПолноеИмя, Тег)));
        Если Данные <> Неопределено Тогда
            Возврат Тег;
        КонецЕсли;
    КонецЦикла;

    Возврат Неопределено;

КонецФункции

// Получает сравнение двух тегов.
Функция Сравнить(ПолноеИмя, ТегДо, ТегПосле) Экспорт

    Значения = Новый Структура(
        "full_name,base,head,per_page,page",
        ПолноеИмя,
        ТегДо,
        ТегПосле,
        100,
        1
    );

    Данные = ПолучитьJSON(РаскрытьШаблон(_ШаблонСравнения, Значения));
    Если Данные = Неопределено Тогда
        Возврат Неопределено;
    КонецЕсли;

    Коммиты = ПолучитьПоле(Данные, "commits", Новый Массив);
    ВсегоКоммитов = Коммиты.Количество();
    ВсегоКоммитов = ПолучитьПоле(Данные, "total_commits", ВсегоКоммитов);

    Если ВсегоКоммитов > Коммиты.Количество() Тогда
        ПоследняяСтраница = Цел((ВсегоКоммитов - 1) / 100) + 1;
        Значения.page = ПоследняяСтраница;
        ПоследниеДанные = ПолучитьJSON(РаскрытьШаблон(_ШаблонСравнения, Значения));

        Если ПоследниеДанные <> Неопределено Тогда
            Коммиты = ПолучитьПоле(ПоследниеДанные, "commits", Новый Массив);
            Если Коммиты.Количество() < 11 Тогда
                ПредыдущаяСтраница = ПоследняяСтраница - 1;
                Если ПредыдущаяСтраница = 1 Тогда
                    ПредыдущиеДанные = Данные;
                Иначе
                    Значения.page = ПредыдущаяСтраница;
                    ПредыдущиеДанные = ПолучитьJSON(
                        РаскрытьШаблон(_ШаблонСравнения, Значения)
                    );
                КонецЕсли;
                Если ПредыдущиеДанные <> Неопределено Тогда
                    ПредыдущиеКоммиты = ПолучитьПоле(ПредыдущиеДанные, "commits", Новый Массив);
                    Коммиты = ДополнитьПредыдущимиКоммитами(Коммиты, ПредыдущиеКоммиты, 11);
                КонецЕсли;
            КонецЕсли;
        КонецЕсли;
    КонецЕсли;

    Возврат Новый Структура(
        "URL,Коммиты",
        ПолучитьПоле(Данные, "html_url"),
        НормализоватьКоммиты(Коммиты)
    );

КонецФункции

// Получает до трёхсот последних релизов репозитория.
Функция ПолучитьРелизы(ПолноеИмя) Экспорт

    Результат = Новый Массив;
    Страница = 1;
    Пока Страница <= _МаксимальноеКоличествоСтраницРелизов Цикл
        Значения = Новый Структура(
            "full_name,per_page,page",
            ПолноеИмя,
            100,
            Страница
        );

        Данные = ПолучитьJSON(РаскрытьШаблон(_ШаблонРелизов, Значения));
        Если Данные = Неопределено Тогда
            Прервать;
        КонецЕсли;

        Для Каждого Релиз Из Данные Цикл
            Результат.Добавить(НормализоватьРелиз(Релиз));
        КонецЦикла;

        Если Данные.Количество() < 100 Тогда
            Прервать;
        КонецЕсли;

        Страница = Страница + 1;
    КонецЦикла;

    Возврат Результат;

КонецФункции

// Получает текстовый файл репозитория по указанному тегу.
//
// Параметры:
//   ПолноеИмя - Строка - Репозиторий в формате owner/name.
//   Путь - Строка - Путь к файлу в репозитории.
//   Тег - Строка - Тег, по которому читается файл.
//
// Возвращаемое значение:
//   Строка - Содержимое файла либо пустая строка, если файл недоступен.
Функция ПолучитьФайл(ПолноеИмя, Путь, Тег) Экспорт

    Ресурс = РаскрытьШаблон(
        _ШаблонСодержимого,
        Новый Структура("full_name,path,ref", ПолноеИмя, Путь, Тег)
    );
    Данные = ПолучитьJSON(Ресурс);

    Если Данные = Неопределено Тогда
        Возврат "";
    КонецЕсли;

    Содержимое = ПолучитьПоле(Данные, "content");
    Кодировка = ПолучитьПоле(Данные, "encoding");
    Если Кодировка = "none" Тогда
        Возврат ПолучитьRawСодержимое(Ресурс);
    КонецЕсли;

    Если ПустаяСтрока(Содержимое) Или Кодировка <> "base64" Тогда
        Возврат "";
    КонецЕсли;

    Попытка
        Возврат ПолучитьСтрокуИзДвоичныхДанных(Base64Значение(Содержимое), КодировкаТекста.UTF8);
    Исключение
        Предупредить("Не удалось декодировать файл GitHub: " + РесурсБезПараметров(Путь));
        Возврат "";
    КонецПопытки;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция РаскрытьШаблон(Шаблон, Значения)

    Возврат Шаблон.Раскрыть(Значения).КодированноеПредставление();

КонецФункции

Функция ПолучитьJSON(Ресурс)

    КэшированныйОтвет = _КэшJSON.Получить(Ресурс);
    Если КэшированныйОтвет <> Неопределено Тогда
        Возврат КэшированныйОтвет;
    КонецЕсли;

    Заголовки = Новый Соответствие;
    Заголовки.Вставить("Accept", "application/vnd.github+json");
    Заголовки.Вставить("X-GitHub-Api-Version", "2022-11-28");
    Заголовки.Вставить("User-Agent", "depos-action");

    Если Не ПустаяСтрока(_Токен) Тогда
        Заголовки.Вставить("Authorization", "Bearer " + _Токен);
    КонецЕсли;

    Попытка
        Если _Транспорт = Неопределено Тогда
            Ответ = ВыполнитьHTTPЗапрос(Ресурс, Заголовки);
        Иначе
            Ответ = _Транспорт.Получить(Ресурс, Заголовки);
        КонецЕсли;
    Исключение
        Предупредить("Не удалось получить метаданные GitHub: " + РесурсБезПараметров(Ресурс));
        Возврат Неопределено;
    КонецПопытки;

    Если Ответ.Код = 404 Тогда
        Возврат Неопределено;
    КонецЕсли;

    Если Ответ.Код < 200 Или Ответ.Код >= 300 Тогда
        Предупредить(СтрШаблон("GitHub API вернул код %1 для %2", Ответ.Код, РесурсБезПараметров(Ресурс)));
        Возврат Неопределено;
    КонецЕсли;

    Попытка
        Чтение = Новый ЧтениеJSON;
        Чтение.УстановитьСтроку(Ответ.Тело);
        Данные = ПрочитатьJSON(Чтение, Истина);

        _КэшJSON.Вставить(Ресурс, Данные);
        Возврат Данные;
    Исключение
        Предупредить("GitHub API вернул некорректный JSON для " + РесурсБезПараметров(Ресурс));
        Возврат Неопределено;
    КонецПопытки;

КонецФункции

Функция ПолучитьRawСодержимое(Ресурс)

    Заголовки = Новый Соответствие;
    Заголовки.Вставить("Accept", "application/vnd.github.raw+json");
    Заголовки.Вставить("X-GitHub-Api-Version", "2022-11-28");
    Заголовки.Вставить("User-Agent", "depos-action");

    Если Не ПустаяСтрока(_Токен) Тогда
        Заголовки.Вставить("Authorization", "Bearer " + _Токен);
    КонецЕсли;

    Попытка
        Если _Транспорт = Неопределено Тогда
            Ответ = ВыполнитьHTTPЗапрос(Ресурс, Заголовки);
        Иначе
            Ответ = _Транспорт.Получить(Ресурс, Заголовки);
        КонецЕсли;
    Исключение
        Предупредить("Не удалось получить содержимое GitHub: " + РесурсБезПараметров(Ресурс));
        Возврат "";
    КонецПопытки;

    Если Ответ.Код = 404 Тогда
        Возврат "";
    КонецЕсли;

    Если Ответ.Код < 200 Или Ответ.Код >= 300 Тогда
        Предупредить(СтрШаблон(
            "GitHub API вернул код %1 для %2",
            Ответ.Код,
            РесурсБезПараметров(Ресурс)
        ));
        Возврат "";
    КонецЕсли;

    Возврат Ответ.Тело;

КонецФункции

Функция НормализоватьРелиз(Релиз)

    Возврат Новый Структура(
        "tag_name,name,body,html_url,draft,prerelease",
        ПолучитьПоле(Релиз, "tag_name"),
        ПолучитьПоле(Релиз, "name", Null),
        ПолучитьПоле(Релиз, "body", Null),
        ПолучитьПоле(Релиз, "html_url"),
        ПолучитьПоле(Релиз, "draft", Ложь),
        ПолучитьПоле(Релиз, "prerelease", Ложь)
    );

КонецФункции

Функция НормализоватьКоммиты(Коммиты)

    Результат = Новый Массив;

    Для Каждого Коммит Из Коммиты Цикл
        Результат.Добавить(Новый Структура(
            "sha,html_url,commit",
            ПолучитьПоле(Коммит, "sha"),
            ПолучитьПоле(Коммит, "html_url"),
            Новый Структура("message", ПолучитьВложенноеПоле(Коммит, "commit", "message"))
        ));
    КонецЦикла;

    Возврат Результат;

КонецФункции

Функция ДополнитьПредыдущимиКоммитами(Последние, Предыдущие, МинимальноеКоличество)

    Результат = Новый Массив;
    Необходимо = МинимальноеКоличество - Последние.Количество();
    ПервыйИндекс = Макс(0, Предыдущие.Количество() - Необходимо);

    Для Индекс = ПервыйИндекс По Предыдущие.Количество() - 1 Цикл
        Результат.Добавить(Предыдущие[Индекс]);
    КонецЦикла;

    Для Каждого Коммит Из Последние Цикл
        Результат.Добавить(Коммит);
    КонецЦикла;

    Возврат Результат;

КонецФункции

Функция ВыполнитьHTTPЗапрос(Ресурс, Заголовки)

    ДополнительныеПараметры = Новый Структура(
        "Заголовки,Таймаут",
        Заголовки,
        30
    );

    Ответ = КоннекторHTTP.Get(_АдресAPI + Ресурс, Неопределено, ДополнительныеПараметры);

    Возврат Новый Структура("Код,Тело", Ответ.КодСостояния, Ответ.Текст());

КонецФункции

Функция ПолучитьВложенноеПоле(Данные, ИмяОбъекта, ИмяПоля)

    Объект = ПолучитьПоле(Данные, ИмяОбъекта, Неопределено);
    Если Объект = Неопределено Тогда
        Возврат "";
    КонецЕсли;

    Возврат ПолучитьПоле(Объект, ИмяПоля);

КонецФункции

Функция ПолучитьПоле(Данные, ИмяПоля, ЗначениеПоУмолчанию = "")

    Если ТипЗнч(Данные) = Тип("Соответствие") Тогда
        Значение = Данные.Получить(ИмяПоля);
    Иначе
        Значение = ЗначениеПоУмолчанию;
        Если Не Данные.Свойство(ИмяПоля, Значение) Тогда
            Возврат ЗначениеПоУмолчанию;
        КонецЕсли;
    КонецЕсли;

    Если ТипЗнч(Значение) = Тип("Null") Или Значение = Неопределено Тогда
        Возврат ЗначениеПоУмолчанию;
    КонецЕсли;

    Возврат Значение;

КонецФункции

Процедура Предупредить(Текст)

    Если _ОбработчикПредупреждения = Неопределено Тогда
        Сообщить("::warning title=Метаданные зависимостей::" + Текст);
    Иначе
        _ОбработчикПредупреждения.Предупредить(Текст);
    КонецЕсли;

КонецПроцедуры

Функция РесурсБезПараметров(Ресурс)

    Позиция = СтрНайти(Ресурс, "?");
    Возврат ?(Позиция = 0, Ресурс, Лев(Ресурс, Позиция - 1));

КонецФункции

#КонецОбласти
