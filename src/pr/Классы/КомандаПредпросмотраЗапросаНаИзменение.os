#Область ПрограммныйИнтерфейс

// Формирует и выводит предпросмотр Pull Request.
//
// Параметры:
//   Команда - КомандаПриложения - Команда cli с разобранными опциями.
//
// Исключения:
//   Вызывает исключение, если не удалось запустить depos или сформировать текст.
Процедура ВыполнитьКоманду(Команда) Экспорт

    Если Команда.ЗначениеОпции("h") Тогда
        Команда.ВывестиСправку();
        Возврат;
    КонецЕсли;

    МенеджерФайлов = Новый МенеджерВременныхФайлов;

    Попытка
        СформироватьПредпросмотр(Команда, МенеджерФайлов);
    Исключение
        МенеджерФайлов.Удалить();
        ВызватьИсключение;
    КонецПопытки;

    МенеджерФайлов.Удалить();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура СформироватьПредпросмотр(Команда, МенеджерФайлов)

    Манифест = Команда.ЗначениеОпции("manifest");
    Фильтр = Команда.ЗначениеОпции("filter");
    Цель = Команда.ЗначениеОпции("target");
    Префикс = Команда.ЗначениеОпции("message-prefix");
    ПутьВывода = Команда.ЗначениеОпции("output");

    ПроверитьЦель(Цель);
    ПроверитьПрефикс(Префикс);

    ПутьМанифеста = ПолучитьПутьМанифеста(Манифест);
    Обновления = ПолучитьОбновления(Фильтр, Цель, ПутьМанифеста, МенеджерФайлов);

    Если Обновления = Неопределено Тогда
        Сообщить("Обновлений зависимостей нет. Pull Request не будет создан.");
        Возврат;
    КонецЕсли;

    Обновления = ОбогатитьМетаданными(Обновления);
    Форматировщик = Новый ФорматировщикЗапросаНаИзменение;

    Результат = Форматировщик.Сформировать(Обновления, Префикс, Манифест, Цель);
    Если ПустаяСтрока(ПутьВывода) Тогда
        ВывестиРезультат(Результат);
    Иначе
        ЗаписатьТелоВФайл(ПутьВывода, Результат.Тело);
    КонецЕсли;

КонецПроцедуры

Процедура ЗаписатьТелоВФайл(Путь, Тело)

    Запись = Новый ЗаписьТекста(Путь, "UTF-8");
    Запись.Записать(Тело);
    Запись.Закрыть();

КонецПроцедуры

Процедура ВывестиРезультат(Результат)

    Сообщить("");
    Сообщить("Pull Request title:");
    Сообщить(Результат.Заголовок);
    Сообщить("");
    Сообщить("Pull Request body:");
    Сообщить(Результат.Тело);

КонецПроцедуры

Процедура ПроверитьЦель(Цель)

    Если Цель <> "latest" И Цель <> "minor" И Цель <> "patch" Тогда
        ВызватьИсключение "Параметр --target должен иметь значение latest, minor или patch";
    КонецЕсли;

КонецПроцедуры

Процедура ПроверитьПрефикс(Префикс)

    Если СтрНайти(Префикс, Символы.ПС) > 0
        Или СтрНайти(Префикс, Символы.ВК) > 0 Тогда
        ВызватьИсключение "Параметр --message-prefix не должен содержать переводы строк";
    КонецЕсли;

КонецПроцедуры

Функция ПолучитьПутьМанифеста(Путь)

    Файл = Новый Файл(Путь);
    Если Файл.Существует() И Файл.ЭтоКаталог() Тогда
        Файл = Новый Файл(ОбъединитьПути(Файл.ПолноеИмя, "packagedef"));
    КонецЕсли;

    Если Не Файл.Существует() Или Файл.ЭтоКаталог() Тогда
        ВызватьИсключение СтрШаблон("Файл packagedef не найден: %1", Путь);
    КонецЕсли;

    Возврат Файл.ПолноеИмя;

КонецФункции

Функция КакАргументКоманды(Значение)

    Если СтрНайти(Значение, """") > 0
        Или СтрНайти(Значение, Символы.ПС) > 0
        Или СтрНайти(Значение, Символы.ВК) > 0 Тогда
        ВызватьИсключение "Значение параметра не должно содержать кавычки или переводы строк";
    КонецЕсли;

    Возврат """" + Значение + """";

КонецФункции

Процедура ВыполнитьВнешнююКоманду(Команда, Имя)

    КодВозврата = 0;

    Попытка
        ЗапуститьПриложение(Команда, , Истина, КодВозврата);
    Исключение
        ВызватьИсключение СтрШаблон("Не удалось запустить %1: %2", Имя, ОписаниеОшибки());
    КонецПопытки;

    Если КодВозврата <> 0 Тогда
        ВызватьИсключение СтрШаблон("Команда %1 завершилась с кодом %2", Имя, КодВозврата);
    КонецЕсли;

КонецПроцедуры

Функция ПолучитьОбновления(Фильтр, Цель, ПутьМанифеста, МенеджерФайлов)

    ВременныйМанифест = МенеджерФайлов.НовоеИмяФайла("packagedef");
    ПутьОтчета = МенеджерФайлов.НовоеИмяФайла("json");
    КопироватьФайл(ПутьМанифеста, ВременныйМанифест);

    Команда = "depos upgrade"
        + " --manifest " + КакАргументКоманды(ВременныйМанифест)
        + " --target " + КакАргументКоманды(Цель)
        + " --output " + КакАргументКоманды(ПутьОтчета);

    Если Не ПустаяСтрока(Фильтр) Тогда
        Команда = Команда + " --filter " + КакАргументКоманды(Фильтр);
    КонецЕсли;

    ВыполнитьВнешнююКоманду(Команда, "depos");

    Если Не Новый Файл(ПутьОтчета).Существует() Тогда
        Возврат Неопределено;
    КонецЕсли;

    ЧитательОтчета = Новый ЧитательОтчетаОбновлений;
    Возврат ЧитательОтчета.Прочитать(ПутьОтчета);

КонецФункции

Функция ОбогатитьМетаданными(Обновления)

    Токен = ПолучитьПеременнуюСреды("GH_TOKEN");
    Если ПустаяСтрока(Токен) Тогда
        Сообщить("Предупреждение: GH_TOKEN не задан; release notes и коммиты не будут загружены.");
        Возврат Обновления;
    КонецЕсли;

    Возврат МетаданныеGitHub.ОбогатитьВсе(Обновления, Токен);

КонецФункции

#КонецОбласти
