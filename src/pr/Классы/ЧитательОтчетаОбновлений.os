#Использовать semver

#Область ПрограммныйИнтерфейс

// Читает и проверяет JSON-отчёт depos.
//
// Параметры:
//   Путь - Строка - Путь к JSON-файлу отчёта.
//
// Возвращаемое значение:
//   Массив из Структура - Нормализованные записи обновлений.
//
// Исключения:
//   Вызывает исключение, если файл отсутствует, JSON некорректен или отчёт не содержит обновлений.
Функция Прочитать(Путь) Экспорт

    Если ПустаяСтрока(Путь) Или Не Новый Файл(Путь).Существует() Тогда
        ВызватьИсключение СтрШаблон("Отсутствует отчёт depos: %1", Путь);
    КонецЕсли;

    Попытка
        Чтение = Новый ЧтениеJSON;
        Чтение.ОткрытьФайл(Путь);
        Данные = ПрочитатьJSON(Чтение);
        Чтение.Закрыть();
    Исключение
        ВызватьИсключение "Некорректный отчёт depos: JSON не может быть прочитан";
    КонецПопытки;

    Если ТипЗнч(Данные) <> Тип("Массив") Или Данные.Количество() = 0 Тогда
        ВызватьИсключение "Некорректный отчёт depos: ожидался непустой массив обновлений";
    КонецЕсли;

    Результат = Новый Массив;
    Для Каждого Запись Из Данные Цикл
        Результат.Добавить(НормализоватьЗапись(Запись));
    КонецЦикла;

    Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НормализоватьЗапись(Запись)

    ИмяПакета = Неопределено;
    ВерсияДо = Неопределено;
    ВерсияПосле = Неопределено;

    Если ТипЗнч(Запись) <> Тип("Структура")
        Или Не Запись.Свойство("packageName", ИмяПакета)
        Или Не Запись.Свойство("minVersionBefore", ВерсияДо)
        Или Не Запись.Свойство("minVersionAfter", ВерсияПосле)
        Или ТипЗнч(ИмяПакета) <> Тип("Строка")
        Или ТипЗнч(ВерсияДо) <> Тип("Строка")
        Или ТипЗнч(ВерсияПосле) <> Тип("Строка")
        Или ПустаяСтрока(ИмяПакета)
        Или ПустаяСтрока(ВерсияДо)
        Или ПустаяСтрока(ВерсияПосле) Тогда
        ВызватьИсключение "Некорректный отчёт depos: запись обновления неполна";
    КонецЕсли;

    Если ЭтоЧетырехкомпонентнаяВерсия(ВерсияДо) Или ЭтоЧетырехкомпонентнаяВерсия(ВерсияПосле) Тогда
        КомпонентыДо = КомпонентыДляЧетырехкомпонентнойВерсии(ВерсияДо);
        КомпонентыПосле = КомпонентыДляЧетырехкомпонентнойВерсии(ВерсияПосле);
        Если КомпонентыДо = Неопределено Или КомпонентыПосле = Неопределено Тогда
            ВызватьИсключение "Некорректный отчёт depos: версия пакета имеет неподдерживаемый формат";
        КонецЕсли;

        ТипОбновления = ОпределитьТипЧетырехкомпонентногоОбновления(КомпонентыДо, КомпонентыПосле);
    Иначе
        ВерсияДоОбъект = Новый Версия(ВерсияДо);
        ВерсияПослеОбъект = Новый Версия(ВерсияПосле);
        Если ВерсияДоОбъект.Ошибка() Или ВерсияПослеОбъект.Ошибка() Тогда
            ВызватьИсключение "Некорректный отчёт depos: версия пакета имеет неподдерживаемый формат";
        КонецЕсли;

        ТипОбновления = ОпределитьТипОбновления(ВерсияДоОбъект, ВерсияПослеОбъект);
    КонецЕсли;

    Возврат Новый Структура(
        "ИмяПакета,ВерсияДо,ВерсияПосле,Тип",
        ИмяПакета,
        ВерсияДо,
        ВерсияПосле,
        ТипОбновления
    );

КонецФункции

Функция ОпределитьТипОбновления(ВерсияДо, ВерсияПосле)

    Если ВерсияДо.Основная <> ВерсияПосле.Основная Тогда
        Возврат "major";
    ИначеЕсли ВерсияДо.Второстепенная <> ВерсияПосле.Второстепенная Тогда
        Возврат "minor";
    Иначе
        Возврат "patch";
    КонецЕсли;

КонецФункции

Функция ЭтоЧетырехкомпонентнаяВерсия(Представление)

    Число = "(0|[1-9][0-9]*)";
    Шаблон = "^" + Число + "\." + Число + "\." + Число + "\." + Число + "$";

    Возврат Новый РегулярноеВыражение(Шаблон).Совпадает(Представление);

КонецФункции

Функция КомпонентыДляЧетырехкомпонентнойВерсии(Представление)

    Если ЭтоЧетырехкомпонентнаяВерсия(Представление) Тогда
        Возврат СтрРазделить(Представление, ".");
    КонецЕсли;

    ВерсияПакета = Новый Версия(Представление);
    Если ВерсияПакета.Ошибка() Тогда
        Возврат Неопределено;
    КонецЕсли;

    Компоненты = Новый Массив;
    // Для единого сравнения SemVer A.B.C представляется как 0.A.B.C.
    Компоненты.Добавить("0");
    Компоненты.Добавить(Строка(ВерсияПакета.Основная));
    Компоненты.Добавить(Строка(ВерсияПакета.Второстепенная));
    Компоненты.Добавить(Строка(ВерсияПакета.Патч));

    Возврат Компоненты;

КонецФункции

Функция ОпределитьТипЧетырехкомпонентногоОбновления(КомпонентыДо, КомпонентыПосле)

    Если КомпонентыДо[0] <> КомпонентыПосле[0] Или КомпонентыДо[1] <> КомпонентыПосле[1] Тогда
        Возврат "major";
    ИначеЕсли КомпонентыДо[2] <> КомпонентыПосле[2] Тогда
        Возврат "minor";
    Иначе
        Возврат "patch";
    КонецЕсли;

КонецФункции

#КонецОбласти
