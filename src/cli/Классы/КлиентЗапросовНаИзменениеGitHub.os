Перем _Исполнитель; // ИсполнительВнешнихКоманд

#Область ОбработчикиСобытий

// Создает клиент для работы с ветками и Pull Request через gh.
//
// Параметры:
//   ИсполнительВнешнихКоманд - ИсполнительВнешнихКоманд - Запускает gh.
&Желудь
Процедура ПриСозданииОбъекта(&Пластилин ИсполнительВнешнихКоманд)

    _Исполнитель = ИсполнительВнешнихКоманд;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Проверяет существование ветки в репозитории.
//
// Параметры:
//   Репозиторий - Строка - Владелец и имя репозитория через косую черту.
//   Ветка - Строка - Имя ветки.
//
// Возвращаемое значение:
//   Булево - Истина, если ветка существует.
//
// Исключения:
//   Вызывает исключение при ошибке gh или некорректном ответе GitHub.
Функция ВеткаСуществует(Репозиторий, Ветка) Экспорт

    ЧастиРепозитория = СтрРазделить(Репозиторий, "/");
    Если ЧастиРепозитория.Количество() <> 2 Тогда
        ВызватьИсключение "GH_REPO должен содержать владельца и имя репозитория";
    КонецЕсли;

    Аргументы = Новый Массив;
    Аргументы.Добавить("api");
    Аргументы.Добавить("graphql");
    Аргументы.Добавить("-f");
    Аргументы.Добавить("query=query($owner:String!,$repo:String!,$ref:String!){"
        + "repository(owner:$owner,name:$repo){ref(qualifiedName:$ref){name prefix}}}");
    Аргументы.Добавить("-f");
    Аргументы.Добавить("owner=" + ЧастиРепозитория[0]);
    Аргументы.Добавить("-f");
    Аргументы.Добавить("repo=" + ЧастиРепозитория[1]);
    Аргументы.Добавить("-f");
    Аргументы.Добавить("ref=refs/heads/" + Ветка);

    Ответ = ПрочитатьОтвет(Аргументы);
    Данные = Неопределено;
    РепозиторийОтвета = Неопределено;
    Ссылка = Неопределено;

    Если ТипЗнч(Ответ) <> Тип("Структура") Или Не Ответ.Свойство("data", Данные)
        Или ТипЗнч(Данные) <> Тип("Структура") Или Не Данные.Свойство("repository", РепозиторийОтвета)
        Или ТипЗнч(РепозиторийОтвета) <> Тип("Структура")
        Или Не РепозиторийОтвета.Свойство("ref", Ссылка) Тогда
        ВызватьИсключение "gh вернул некорректный ответ при проверке ветки";
    КонецЕсли;

    Если Ссылка = Null Или Ссылка = Неопределено Тогда
        Возврат Ложь;
    КонецЕсли;

    ИмяСсылки = Неопределено;
    ПрефиксСсылки = Неопределено;
    Если ТипЗнч(Ссылка) <> Тип("Структура")
        Или Не Ссылка.Свойство("name", ИмяСсылки) Или ИмяСсылки <> Ветка
        Или Не Ссылка.Свойство("prefix", ПрефиксСсылки) Или ПрефиксСсылки <> "refs/heads/" Тогда
        ВызватьИсключение "gh вернул некорректную ссылку ветки";
    КонецЕсли;

    Возврат Истина;

КонецФункции

// Возвращает открытые Pull Request по имени исходной ветки без ограничения базовой ветки.
//
// Параметры:
//   Ветка - Строка - Имя исходной ветки.
//
// Возвращаемое значение:
//   Массив из Структура - Открытые Pull Request.
//
// Исключения:
//   Вызывает исключение при ошибке gh или некорректном списке.
Функция ПолучитьОткрытые(Ветка) Экспорт

    Аргументы = Новый Массив;
    Для Каждого Аргумент Из СтрРазделить("pr,list,--head", ",") Цикл
        Аргументы.Добавить(Аргумент);
    КонецЦикла;

    Аргументы.Добавить(Ветка);
    Для Каждого Аргумент Из СтрРазделить("--state,open,--json", ",") Цикл
        Аргументы.Добавить(Аргумент);
    КонецЦикла;

    Аргументы.Добавить("number,body,baseRefName,isCrossRepository");
    Аргументы.Добавить("--limit");
    Аргументы.Добавить("1000");

    Запросы = ПрочитатьОтвет(Аргументы);
    Если ТипЗнч(Запросы) <> Тип("Массив") Тогда
        ВызватьИсключение "gh вернул некорректный список Pull Request";
    КонецЕсли;

    Возврат Запросы;

КонецФункции

// Определяет, принадлежит ли Pull Request действию для выбранной базы.
//
// Параметры:
//   Запрос - Структура - Запись gh pr list.
//   База - Строка - Базовая ветка.
//
// Возвращаемое значение:
//   Булево - Истина для управляемого Pull Request.
//
// Исключения:
//   Вызывает исключение, если запись Pull Request не содержит обязательных полей.
Функция ЭтоУправляемый(Запрос, База) Экспорт

    Тело = Неопределено;
    БазоваяВетка = Неопределено;
    ИзФорка = Неопределено;

    Если ТипЗнч(Запрос) <> Тип("Структура")
        Или Не Запрос.Свойство("body", Тело)
        Или Не Запрос.Свойство("baseRefName", БазоваяВетка)
        Или Не Запрос.Свойство("isCrossRepository", ИзФорка) Тогда
        ВызватьИсключение "gh вернул некорректный Pull Request";
    КонецЕсли;

    Возврат БазоваяВетка = База И ИзФорка = Ложь И ТипЗнч(Тело) = Тип("Строка")
        И СтрНайти(Тело, МаркерУправляемогоЗапроса.Значение()) > 0;

КонецФункции

// Закрывает Pull Request и при необходимости удаляет его ветку.
//
// Параметры:
//   Номер - Число - Номер Pull Request.
//   УдалитьВетку - Булево - Удалить ветку после закрытия.
//
// Исключения:
//   Вызывает исключение при ошибке gh.
Процедура Закрыть(Номер, УдалитьВетку) Экспорт

    Аргументы = Новый Массив;
    Аргументы.Добавить("pr");
    Аргументы.Добавить("close");
    Аргументы.Добавить(Строка(Номер));
    Аргументы.Добавить("--comment");
    Аргументы.Добавить("Закрыт автоматически, так как обновления в packagedef отсутствуют или уже применены.");

    Если УдалитьВетку Тогда
        Аргументы.Добавить("--delete-branch");
    КонецЕсли;

    ВыполнитьGitHub(Аргументы);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПрочитатьОтвет(Аргументы)

    Чтение = Новый ЧтениеJSON;
    Чтение.УстановитьСтроку(ВыполнитьGitHub(Аргументы));
    Возврат ПрочитатьJSON(Чтение);

КонецФункции

Функция ВыполнитьGitHub(Аргументы)

    Результат = _Исполнитель.ИсполнитьКоманду("gh", Аргументы);
    Если Результат.КодВозврата <> 0 Тогда
        ВызватьИсключение СтрШаблон("gh завершился с кодом %1: %2", Результат.КодВозврата, Результат.Вывод);
    КонецЕсли;

    Возврат Результат.Вывод;

КонецФункции

#КонецОбласти
