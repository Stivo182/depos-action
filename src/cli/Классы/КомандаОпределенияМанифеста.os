Перем _Исполнитель; // ИсполнительВнешнихКоманд
Перем _Параметры; // ПараметрыСредыAction
Перем _ФайлОкружения; // ФайлОкруженияGitHub

#Область ОбработчикиСобытий

// Создает команду определения packagedef.
//
// Параметры:
//   ИсполнительВнешнихКоманд - ИсполнительВнешнихКоманд - Запускает git.
//   ПараметрыСредыAction - ПараметрыСредыAction - Значения среды Action.
//   ФайлОкруженияGitHub - ФайлОкруженияGitHub - Сохраняет переменные в GITHUB_ENV.
&КомандаПриложения(Имя = "resolve-packagedef", Описание = "Проверить путь к packagedef и сохранить его в GITHUB_ENV")
Процедура ПриСозданииОбъекта(
    &Пластилин ИсполнительВнешнихКоманд,
    &Пластилин ПараметрыСредыAction,
    &Пластилин ФайлОкруженияGitHub
)

    _Исполнитель = ИсполнительВнешнихКоманд;
    _Параметры = ПараметрыСредыAction;
    _ФайлОкружения = ФайлОкруженияGitHub;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Проверяет и сохраняет путь к packagedef.
//
// Параметры:
//   Команда - КомандаПриложения - Команда CLI.
//
Процедура ВыполнитьКоманду(Команда) Экспорт

    Попытка
        Манифест = _Параметры.Манифест;
        ПутьВывода = _Параметры.ПутьОкруженияGitHub;

        Если ПустаяСтрока(Манифест) Или ПустаяСтрока(ПутьВывода) Тогда
            ЗавершитьСОшибкой("Отсутствует параметр", "Переменные DEPOS_PACKAGEDEF и GITHUB_ENV обязательны.");
        КонецЕсли;

        Если СтрНайти(Манифест, Символы.ПС) > 0 Или СтрНайти(Манифест, Символы.ВК) > 0 Тогда
            ЗавершитьСОшибкой("Некорректный packagedef", "Путь не должен содержать переводы строк.");
        КонецЕсли;

        ФайлМанифеста = Новый Файл(Манифест);
        Если ФайлМанифеста.Существует() И ФайлМанифеста.ЭтоКаталог() Тогда
            Манифест = СтрЗаменить(Манифест, "\", "/");
            Манифест = ?(СтрЗаканчиваетсяНа(Манифест, "/"), Манифест, Манифест + "/") + "packagedef";
            ФайлМанифеста = Новый Файл(Манифест);
        КонецЕсли;

        Если Не ФайлМанифеста.Существует() Или Не ФайлМанифеста.ЭтоФайл() Тогда
            ЗавершитьСОшибкой("Не найден packagedef", "Файл не существует: " + Манифест);
        КонецЕсли;

        Аргументы = Новый Массив;
        Аргументы.Добавить("ls-files");
        Аргументы.Добавить("--error-unmatch");
        Аргументы.Добавить("--");
        Аргументы.Добавить(Манифест);

        Результат = _Исполнитель.ИсполнитьКоманду("git", Аргументы);
        Если Результат.КодВозврата <> 0 Тогда
            ЗавершитьСОшибкой(
                "Незарегистрированный packagedef",
                "Файл должен находиться под контролем Git: " + Манифест
            );
        КонецЕсли;

        Аргументы = Новый Массив;
        Аргументы.Добавить("ls-files");
        Аргументы.Добавить("--stage");
        Аргументы.Добавить("--");
        Аргументы.Добавить(Манифест);

        Результат = _Исполнитель.ИсполнитьКоманду("git", Аргументы);

        Если Результат.КодВозврата <> 0 Тогда
            ЗавершитьСОшибкой("Ошибка проверки packagedef", Результат.Вывод);
        КонецЕсли;

        Если СтрНачинаетсяС(Результат.Вывод, "120000 ") Тогда
            ЗавершитьСОшибкой("Недопустимый packagedef", "Символическая ссылка не может использоваться: " + Манифест);
        КонецЕсли;

        Аргументы = Новый Массив;
        Аргументы.Добавить("diff");
        Аргументы.Добавить("--raw");
        Аргументы.Добавить("--");
        Аргументы.Добавить(Манифест);

        Результат = _Исполнитель.ИсполнитьКоманду("git", Аргументы);

        Если Результат.КодВозврата <> 0 Тогда
            ЗавершитьСОшибкой("Ошибка проверки packagedef", Результат.Вывод);
        КонецЕсли;

        Если СтрНайти(Результат.Вывод, " 120000 ") > 0 Тогда
            ЗавершитьСОшибкой("Недопустимый packagedef", "Символическая ссылка не может использоваться: " + Манифест);
        КонецЕсли;

        Значения = Новый Структура("DEPOS_PACKAGEDEF", Манифест);
        _ФайлОкружения.Записать(ПутьВывода, Значения);

    Исключение
        ЗавершитьСОшибкой("Ошибка определения packagedef", ОписаниеОшибки());
    КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗавершитьСОшибкой(Заголовок, Текст)

    Сообщить(СтрШаблон("::error title=%1::%2", Заголовок, Текст));
    ЗавершитьРаботу(1);

КонецПроцедуры

#КонецОбласти
