Перем _Исполнитель; // ИсполнительВнешнихКоманд
Перем _Параметры; // ПараметрыСредыAction
Перем _ЧитательОтчета; // ЧитательОтчетаОбновлений
Перем _Форматировщик; // ФорматировщикЗапросаНаИзменение

&Опция(Имя = "manifest", Описание = "Файл packagedef или содержащий его каталог")
&ТСтрока
&ПоУмолчанию("packagedef")
Перем _Манифест;

&Опция(Имя = "filter", Описание = "Фильтр пакетов depos")
&ТСтрока
Перем _Фильтр;

&Опция(Имя = "target", Описание = "Тип целевой версии: latest, minor или patch")
&ТСтрока
&ПоУмолчанию("latest")
Перем _Цель;

&Опция(Имя = "engine", Описание = "Целевая версия OneScript: auto, current или номер версии")
&ТСтрока
Перем _Движок;

&Опция(Имя = "message-prefix", Описание = "Префикс заголовка Pull Request")
&ТСтрока
&ПоУмолчанию("build(deps)")
Перем _Префикс;

&Опция(Имя = "output", Описание = "Путь к Markdown-файлу с телом Pull Request")
&ТСтрока
Перем _ПутьВывода;

&Опция(Имя = "h", Описание = "Показать справку")
&Флаг
Перем _Справка;

#Область ОбработчикиСобытий

// Создает команду предпросмотра Pull Request.
//
// Параметры:
//   ИсполнительВнешнихКоманд - ИсполнительВнешнихКоманд - Запускает depos.
//   ПараметрыСредыAction - ПараметрыСредыAction - Значения среды Action.
//   ЧитательОтчетаОбновлений - ЧитательОтчетаОбновлений - Читает отчет depos.
//   ФорматировщикЗапросаНаИзменение - ФорматировщикЗапросаНаИзменение - Формирует текст PR.
&КомандаПриложения(Имя = "preview-pr", Описание = "Сформировать предпросмотр Pull Request")
Процедура ПриСозданииОбъекта(
    &Пластилин ИсполнительВнешнихКоманд,
    &Пластилин ПараметрыСредыAction,
    &Пластилин ЧитательОтчетаОбновлений,
    &Пластилин ФорматировщикЗапросаНаИзменение
)

    _Исполнитель = ИсполнительВнешнихКоманд;
    _Параметры = ПараметрыСредыAction;
    _ЧитательОтчета = ЧитательОтчетаОбновлений;
    _Форматировщик = ФорматировщикЗапросаНаИзменение;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Формирует и выводит предпросмотр Pull Request.
//
// Параметры:
//   Команда - КомандаПриложения - Команда cli с разобранными опциями.
//
// Исключения:
//   Вызывает исключение, если не удалось запустить depos или сформировать текст.
Процедура ВыполнитьКоманду(Команда) Экспорт

    Если Команда.ЗначениеОпции("h") = Истина Тогда
        Команда.ВывестиСправку();
        Возврат;
    КонецЕсли;

    МенеджерФайлов = Новый МенеджерВременныхФайлов;

    Попытка
        СформироватьПредпросмотр(Команда, МенеджерФайлов);
    Исключение
        МенеджерФайлов.Удалить();
        ВызватьИсключение;
    КонецПопытки;

    МенеджерФайлов.Удалить();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура СформироватьПредпросмотр(Команда, МенеджерФайлов)

    Манифест = Команда.ЗначениеОпции("manifest");
    Фильтр = Команда.ЗначениеОпции("filter");
    Цель = Команда.ЗначениеОпции("target");
    Движок = Команда.ЗначениеОпции("engine");
    Префикс = Команда.ЗначениеОпции("message-prefix");
    ПутьВывода = Команда.ЗначениеОпции("output");

    ПроверитьЦель(Цель);
    ПроверитьПрефикс(Префикс);

    ПутьМанифеста = ПолучитьПутьМанифеста(Манифест);
    Обновления = ПолучитьОбновления(Фильтр, Цель, Движок, ПутьМанифеста, МенеджерФайлов);

    Если Обновления = Неопределено Тогда
        Сообщить("Обновлений зависимостей нет. Pull Request не будет создан.");
        Возврат;
    КонецЕсли;

    Обновления = ОбогатитьМетаданными(Обновления);
    Результат = _Форматировщик.Сформировать(Обновления, Префикс, Манифест, Цель, Движок);
    Если ПустаяСтрока(ПутьВывода) Тогда
        ВывестиРезультат(Результат);
    Иначе
        ЗаписатьТелоВФайл(ПутьВывода, Результат.Тело);
    КонецЕсли;

КонецПроцедуры

Процедура ЗаписатьТелоВФайл(Путь, Тело)

    Запись = Новый ЗаписьТекста(Путь, "UTF-8");
    Запись.Записать(Тело);
    Запись.Закрыть();

КонецПроцедуры

Процедура ВывестиРезультат(Результат)

    Сообщить("");
    Сообщить("Pull Request title:");
    Сообщить(Результат.Заголовок);
    Сообщить("");
    Сообщить("Pull Request body:");
    Сообщить(Результат.Тело);

КонецПроцедуры

Процедура ПроверитьЦель(Цель)

    Если Цель <> "latest" И Цель <> "minor" И Цель <> "patch" Тогда
        ВызватьИсключение "Параметр --target должен иметь значение latest, minor или patch";
    КонецЕсли;

КонецПроцедуры

Процедура ПроверитьПрефикс(Префикс)

    Если СтрНайти(Префикс, Символы.ПС) > 0
        Или СтрНайти(Префикс, Символы.ВК) > 0 Тогда
        ВызватьИсключение "Параметр --message-prefix не должен содержать переводы строк";
    КонецЕсли;

КонецПроцедуры

Функция ПолучитьПутьМанифеста(Путь)

    Файл = Новый Файл(Путь);
    Если Файл.Существует() И Файл.ЭтоКаталог() Тогда
        Файл = Новый Файл(ОбъединитьПути(Файл.ПолноеИмя, "packagedef"));
    КонецЕсли;

    Если Не Файл.Существует() Или Файл.ЭтоКаталог() Тогда
        ВызватьИсключение СтрШаблон("Файл packagedef не найден: %1", Путь);
    КонецЕсли;

    Возврат Файл.ПолноеИмя;

КонецФункции

Процедура ВыполнитьВнешнююКоманду(Аргументы, Имя)

    Попытка
        Результат = _Исполнитель.ИсполнитьКоманду(Имя, Аргументы, Истина);
    Исключение
        ВызватьИсключение СтрШаблон("Не удалось запустить %1: %2", Имя, ОписаниеОшибки());
    КонецПопытки;

    Если Результат.КодВозврата <> 0 Тогда
        ВызватьИсключение СтрШаблон("Команда %1 завершилась с кодом %2", Имя, Результат.КодВозврата);
    КонецЕсли;

КонецПроцедуры

Функция ПолучитьОбновления(Фильтр, Цель, Движок, ПутьМанифеста, МенеджерФайлов)

    ВременныйМанифест = МенеджерФайлов.НовоеИмяФайла("packagedef");
    ПутьОтчета = МенеджерФайлов.НовоеИмяФайла("json");
    КопироватьФайл(ПутьМанифеста, ВременныйМанифест);

    Аргументы = Новый Массив;
    Аргументы.Добавить("upgrade");
    Аргументы.Добавить("--manifest");
    Аргументы.Добавить(ВременныйМанифест);
    Аргументы.Добавить("--target");
    Аргументы.Добавить(Цель);
    Аргументы.Добавить("--format");
    Аргументы.Добавить("json");
    Аргументы.Добавить("--output");
    Аргументы.Добавить(ПутьОтчета);

    Если Не ПустаяСтрока(Фильтр) Тогда
        Аргументы.Добавить("--filter");
        Аргументы.Добавить(Фильтр);
    КонецЕсли;

    Если Не ПустаяСтрока(Движок) Тогда
        Аргументы.Добавить("--engine");
        Аргументы.Добавить(Движок);
    КонецЕсли;

    ВыполнитьВнешнююКоманду(Аргументы, "depos");

    Если Не Новый Файл(ПутьОтчета).Существует() Тогда
        Возврат Неопределено;
    КонецЕсли;

    Возврат _ЧитательОтчета.Прочитать(ПутьОтчета);

КонецФункции

Функция ОбогатитьМетаданными(Обновления)

    Токен = _Параметры.ТокенGitHub;
    Если ПустаяСтрока(Токен) Тогда
        Сообщить("Предупреждение: GH_TOKEN не задан; release notes и коммиты не будут загружены.");
        Возврат Обновления;
    КонецЕсли;

    Возврат МетаданныеGitHub.ОбогатитьВсе(Обновления, Токен);

КонецФункции

#КонецОбласти
