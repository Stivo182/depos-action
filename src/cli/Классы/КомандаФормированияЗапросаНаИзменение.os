Перем _Параметры; // ПараметрыСредыAction
Перем _ЧитательОтчета; // ЧитательОтчетаОбновлений
Перем _Форматировщик; // ФорматировщикЗапросаНаИзменение

#Область ОбработчикиСобытий

// Создает команду формирования Pull Request.
//
// Параметры:
//   ПараметрыСредыAction - ПараметрыСредыAction - Значения среды Action.
//   ЧитательОтчетаОбновлений - ЧитательОтчетаОбновлений - Читает отчет depos.
//   ФорматировщикЗапросаНаИзменение - ФорматировщикЗапросаНаИзменение - Формирует текст PR.
&КомандаПриложения(Имя = "format-pr", Описание = "Подготовить title и body Pull Request для GitHub Action")
Процедура ПриСозданииОбъекта(
    &Пластилин ПараметрыСредыAction,
    &Пластилин ЧитательОтчетаОбновлений,
    &Пластилин ФорматировщикЗапросаНаИзменение
)

    _Параметры = ПараметрыСредыAction;
    _ЧитательОтчета = ЧитательОтчетаОбновлений;
    _Форматировщик = ФорматировщикЗапросаНаИзменение;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Формирует заголовок и тело Pull Request для GitHub Action.
//
// Параметры:
//   Команда - КомандаПриложения - Команда CLI.
//
// Исключения:
//   Вызывает исключение, если не удалось получить метаданные обновлений.
Процедура ВыполнитьКоманду(Команда) Экспорт

    ОтчетПуть = _Параметры.ПутьОтчета;
    Префикс = _Параметры.ПрефиксСообщения;
    ПутьВывода = _Параметры.ПутьВыводаGitHub;

    Если ПустаяСтрока(ОтчетПуть) Тогда
        ЗавершитьСОшибкой("Отсутствует отчёт depos", "Переменная DEPOS_REPORT_PATH обязательна");
    КонецЕсли;

    Если ПустаяСтрока(ПутьВывода) Тогда
        ЗавершитьСОшибкой("Отсутствует GITHUB_OUTPUT", "Переменная GITHUB_OUTPUT обязательна");
    КонецЕсли;

    Если СтрНайти(Префикс, Символы.ПС) > 0 Или СтрНайти(Префикс, Символы.ВК) > 0 Тогда
        ЗавершитьСОшибкой("Некорректный message-prefix", "Префикс не должен содержать переводы строк.");
    КонецЕсли;

    Попытка
        Обновления = _ЧитательОтчета.Прочитать(ОтчетПуть);
    Исключение
        ЗавершитьСОшибкой("Некорректный отчёт depos", ОписаниеОшибки());
    КонецПопытки;

    Токен = _Параметры.ТокенGitHub;
    Если Не ПустаяСтрока(Токен) Тогда
        Обновления = МетаданныеGitHub.ОбогатитьВсе(Обновления, Токен);
    КонецЕсли;

    Результат = _Форматировщик.Сформировать(
        Обновления,
        Префикс,
        _Параметры.Манифест,
        _Параметры.Цель,
        _Параметры.Движок
    );

    ЗаписатьВывод("title", Результат.Заголовок);
    ЗаписатьВывод("body", Результат.Тело);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаписатьВывод(Имя, Значение)

    ПутьВывода = _Параметры.ПутьВыводаGitHub;

    Разделитель = "depos_" + СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "_");
    Пока СтрНайти(Символы.ПС + Значение + Символы.ПС, Символы.ПС + Разделитель + Символы.ПС) > 0 Цикл
        Разделитель = Разделитель + "_x";
    КонецЦикла;

    Запись = Новый ЗаписьТекста(ПутьВывода, "UTF-8", Символы.ПС, Истина, Символы.ПС);
    Запись.ЗаписатьСтроку(Имя + "<<" + Разделитель);
    Запись.ЗаписатьСтроку(Значение);
    Запись.ЗаписатьСтроку(Разделитель);
    Запись.Закрыть();

КонецПроцедуры

Процедура ЗавершитьСОшибкой(Заголовок, Текст)

    Сообщить(СтрШаблон("::error title=%1::%2", Заголовок, Текст));
    ЗавершитьРаботу(1);

КонецПроцедуры

#КонецОбласти
