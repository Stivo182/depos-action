Перем _Исполнитель; // ИсполнительВнешнихКоманд
Перем _Параметры; // ПараметрыСредыAction
Перем _ФайлОкружения; // ФайлОкруженияGitHub

#Область ОбработчикиСобытий

// Создает команду подготовки параметров Action.
//
// Параметры:
//   ИсполнительВнешнихКоманд - ИсполнительВнешнихКоманд - Запускает git.
//   ПараметрыСредыAction - ПараметрыСредыAction - Значения среды Action.
//   ФайлОкруженияGitHub - ФайлОкруженияGitHub - Сохраняет переменные в GITHUB_ENV.
&КомандаПриложения(Имя = "prepare", Описание = "Проверить входные параметры Action и подготовить GITHUB_ENV")
Процедура ПриСозданииОбъекта(
    &Пластилин ИсполнительВнешнихКоманд,
    &Пластилин ПараметрыСредыAction,
    &Пластилин ФайлОкруженияGitHub
)

    _Исполнитель = ИсполнительВнешнихКоманд;
    _Параметры = ПараметрыСредыAction;
    _ФайлОкружения = ФайлОкруженияGitHub;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Проверяет параметры Action и сохраняет вычисленные значения в GITHUB_ENV.
//
// Параметры:
//   Команда - КомандаПриложения - Команда CLI.
Процедура ВыполнитьКоманду(Команда) Экспорт

    Попытка
        ПодготовитьПараметры();
    Исключение
        ЗавершитьСОшибкой("Ошибка подготовки параметров", ОписаниеОшибки());
    КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПодготовитьПараметры()

    Цель = _Параметры.Цель;
    Манифест = _Параметры.Манифест;
    ВременныйКаталог = _Параметры.ВременныйКаталог;
    ПутьВывода = _Параметры.ПутьОкруженияGitHub;

    ПроверитьВходныеПараметры(Цель, Манифест, ВременныйКаталог, ПутьВывода);
    БазаПоУмолчанию = _Параметры.ВеткаРепозиторияПоУмолчанию;
    База = ОпределитьБазу(БазаПоУмолчанию);
    Манифест = НормализоватьМанифест(Манифест);
    Ветка = ОпределитьВетку(Цель, База, БазаПоУмолчанию);

    Если СтрЗаканчиваетсяНа(ВременныйКаталог, "/") Тогда
        ВременныйКаталог = Лев(ВременныйКаталог, СтрДлина(ВременныйКаталог) - 1);
    КонецЕсли;

    Значения = Новый Структура;
    Значения.Вставить("DEPOS_BRANCH", Ветка);
    Значения.Вставить("DEPOS_BASE", База);
    Значения.Вставить("DEPOS_PACKAGEDEF", Манифест);
    Значения.Вставить("DEPOS_REPORT_PATH", ВременныйКаталог + "/depos-packages.json");

    _ФайлОкружения.Записать(ПутьВывода, Значения);

КонецПроцедуры

Процедура ПроверитьВходныеПараметры(Цель, Манифест, ВременныйКаталог, ПутьВывода)

    Если ПустаяСтрока(Цель)
        Или ПустаяСтрока(Манифест)
        Или ПустаяСтрока(ВременныйКаталог)
        Или ПустаяСтрока(ПутьВывода) Тогда
        ЗавершитьСОшибкой(
            "Отсутствует параметр",
            "Переменные DEPOS_TARGET, DEPOS_PACKAGEDEF, RUNNER_TEMP и GITHUB_ENV обязательны."
        );
    КонецЕсли;

    Если Цель <> "latest" И Цель <> "minor" И Цель <> "patch" Тогда
        ЗавершитьСОшибкой(
            "Некорректный target",
            СтрШаблон("Допустимые значения: latest, minor, patch. Получено: %1", Цель)
        );
    КонецЕсли;

    Если СтрНайти(Манифест, Символы.ПС) > 0 Или СтрНайти(Манифест, Символы.ВК) > 0 Тогда
        ЗавершитьСОшибкой("Некорректный packagedef", "Путь не должен содержать переводы строк.");
    КонецЕсли;

КонецПроцедуры

Функция ОпределитьБазу(БазаПоУмолчанию)

    База = _Параметры.База;

    Если ПустаяСтрока(База) Тогда
        База = БазаПоУмолчанию;
    КонецЕсли;

    Если ПустаяСтрока(База) Тогда
        База = _Параметры.ИмяСсылкиСобытия;
    КонецЕсли;

    Если ПустаяСтрока(База) Или Не ДопустимоеИмяВетки(База) Тогда
        ЗавершитьСОшибкой(
            "Некорректный base",
            "Недопустимое имя базовой ветки: " + ?(ПустаяСтрока(База), "<пусто>", База)
        );
    КонецЕсли;

    Возврат База;

КонецФункции

Функция НормализоватьМанифест(Манифест)

    Манифест = СтрЗаменить(Манифест, "\", "/");
    Пока СтрНачинаетсяС(Манифест, "./") Цикл
        Манифест = Сред(Манифест, 3);
    КонецЦикла;

    Если ПустаяСтрока(Манифест) Или СтрНачинаетсяС(Манифест, "/")
        Или Новый РегулярноеВыражение("^[A-Za-z]:/").Совпадает(Манифест) Тогда
        ЗавершитьСОшибкой("Некорректный packagedef", "Укажите относительный путь внутри репозитория.");
    КонецЕсли;

    Для Каждого ЧастьПути Из СтрРазделить(Манифест, "/") Цикл
        Если ЧастьПути = ".." Тогда
            ЗавершитьСОшибкой("Некорректный packagedef", "Путь не должен содержать сегменты '..'.");
        КонецЕсли;
    КонецЦикла;

    Возврат Манифест;

КонецФункции

Функция ОпределитьВетку(Цель, База, БазаПоУмолчанию)

    Ветка = _Параметры.Ветка;
    Если ПустаяСтрока(Ветка) Тогда
        Ветка = "depos/bump-deps/" + Цель;
        Если Не ПустаяСтрока(БазаПоУмолчанию) И База <> БазаПоУмолчанию Тогда
            Ветка = Ветка + "/" + База;
        КонецЕсли;
    КонецЕсли;

    Если Не ДопустимоеИмяВетки(Ветка) Тогда
        ЗавершитьСОшибкой("Некорректный branch", "Недопустимое имя ветки: " + Ветка);
    КонецЕсли;

    Возврат Ветка;

КонецФункции

Функция ДопустимоеИмяВетки(Имя)

    Аргументы = Новый Массив;
    Аргументы.Добавить("check-ref-format");
    Аргументы.Добавить("--branch");
    Аргументы.Добавить(Имя);

    Возврат _Исполнитель.ИсполнитьКоманду("git", Аргументы).КодВозврата = 0;

КонецФункции

Процедура ЗавершитьСОшибкой(Заголовок, Текст)

    Сообщить(СтрШаблон("::error title=%1::%2", Заголовок, Текст));
    ЗавершитьРаботу(1);

КонецПроцедуры

#КонецОбласти
