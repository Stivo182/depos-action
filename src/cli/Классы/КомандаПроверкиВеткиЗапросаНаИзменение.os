Перем _Клиент; // КлиентЗапросовНаИзменениеGitHub
Перем _Параметры; // ПараметрыСредыAction

#Область ОбработчикиСобытий

// Создает команду проверки ветки перед обновлением Pull Request.
//
// Параметры:
//   КлиентЗапросовНаИзменениеGitHub - КлиентЗапросовНаИзменениеGitHub - Работает с ветками и Pull Request.
//   ПараметрыСредыAction - ПараметрыСредыAction - Значения среды Action.
&КомандаПриложения(Имя = "check-branch", Описание = "Проверить право на обновление ветки Pull Request")
Процедура ПриСозданииОбъекта(&Пластилин КлиентЗапросовНаИзменениеGitHub, &Пластилин ПараметрыСредыAction)

    _Клиент = КлиентЗапросовНаИзменениеGitHub;
    _Параметры = ПараметрыСредыAction;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Проверяет, что существующая ветка связана с единственным управляемым Pull Request для выбранной базы.
//
// Параметры:
//   Команда - КомандаПриложения - Команда CLI.
//
// Исключения:
//   Вызывает исключение, если gh вернул ошибку, некорректный ответ или ветка занята другим Pull Request.
Процедура ВыполнитьКоманду(Команда) Экспорт

    Ветка = ОбязательнаяПеременная("DEPOS_BRANCH", _Параметры.Ветка);
    База = ОбязательнаяПеременная("DEPOS_BASE", _Параметры.База);
    Репозиторий = ОбязательнаяПеременная("GH_REPO", _Параметры.РепозиторийGitHub);

    Если Не _Клиент.ВеткаСуществует(Репозиторий, Ветка) Тогда
        Возврат;
    КонецЕсли;

    Запросы = _Клиент.ПолучитьОткрытые(Ветка);
    Если Запросы.Количество() = 1 И _Клиент.ЭтоУправляемый(Запросы[0], База) Тогда
        Возврат;
    КонецЕсли;

    ВызватьИсключение СтрШаблон(
        "Ветка %1 уже существует, но не принадлежит единственному открытому Pull Request depos-action в базу %2. "
        + "Укажите другое имя branch или разберите существующую ветку вручную.", Ветка, База);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОбязательнаяПеременная(Имя, Значение)

    Если ПустаяСтрока(Значение) Тогда
        ВызватьИсключение "Переменная " + Имя + " обязательна";
    КонецЕсли;

    Возврат Значение;

КонецФункции

#КонецОбласти
