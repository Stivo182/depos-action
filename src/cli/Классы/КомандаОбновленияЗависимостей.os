#Использовать semver

Перем _Исполнитель; // ИсполнительВнешнихКоманд
Перем _Параметры; // ПараметрыСредыAction

#Область ОбработчикиСобытий

// Создает команду обновления зависимостей.
//
// Параметры:
//   ИсполнительВнешнихКоманд - ИсполнительВнешнихКоманд - Запускает opm и depos.
//   ПараметрыСредыAction - ПараметрыСредыAction - Значения среды Action.
&КомандаПриложения(Имя = "upgrade", Описание = "Обновить зависимости через depos")
Процедура ПриСозданииОбъекта(&Пластилин ИсполнительВнешнихКоманд, &Пластилин ПараметрыСредыAction)

    _Исполнитель = ИсполнительВнешнихКоманд;
    _Параметры = ПараметрыСредыAction;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Обновляет зависимости проекта через depos.
//
// Параметры:
//   Команда - КомандаПриложения - Команда CLI.
//
Процедура ВыполнитьКоманду(Команда) Экспорт

    Попытка
        ВерсияDepos = ПрочитатьВерсиюDepos();

        ОбеспечитьВерсиюOPM();
        УстановитьDepos(ВерсияDepos);

        Результат = _Исполнитель.ИсполнитьКоманду("depos", АргументыОбновления(ВерсияDepos), Истина);
        Если Результат.КодВозврата <> 0 Тогда
            ЗавершитьРаботу(Результат.КодВозврата);
        КонецЕсли;
    Исключение
        ЗавершитьСОшибкой("Ошибка обновления зависимостей", ОписаниеОшибки());
    КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ОбеспечитьВерсиюOPM()

    Результат = _Исполнитель.ИсполнитьКоманду("opm", СтрРазделить("-v", ","));
    ВерсияOpm = ВерсияИзТекста(Результат.Вывод);

    МинимальнаяВерсия = _Параметры.МинимальнаяВерсияOPM;
    Если ПустаяСтрока(МинимальнаяВерсия) Тогда
        МинимальнаяВерсия = "1.3.0";
    КонецЕсли;

    Если ПустаяСтрока(ВерсияOpm) Или Не Версии.ВерсияБольшеИлиРавны(ВерсияOpm, МинимальнаяВерсия) Тогда
        Сообщить(СтрШаблон("Обновление opm до версии %1 или новее...", МинимальнаяВерсия));
        Результат = _Исполнитель.ИсполнитьКоманду("opm", СтрРазделить("install,opm", ","), Истина);
        Если Результат.КодВозврата <> 0 Тогда
            ЗавершитьРаботу(Результат.КодВозврата);
        КонецЕсли;
    КонецЕсли;

КонецПроцедуры

Процедура УстановитьDepos(ВерсияDepos)

    Аргументы = Новый Массив;
    Аргументы.Добавить("install");
    Аргументы.Добавить("depos@" + ВерсияDepos);

    Результат = _Исполнитель.ИсполнитьКоманду("opm", Аргументы, Истина);
    Если Результат.КодВозврата <> 0 Тогда
        ЗавершитьРаботу(Результат.КодВозврата);
    КонецЕсли;

КонецПроцедуры

Функция АргументыОбновления(ВерсияDepos)

    Аргументы = Новый Массив;
    Аргументы.Добавить("upgrade");

    Манифест = _Параметры.Манифест;
    Если ПустаяСтрока(Манифест) Тогда
        Манифест = "packagedef";
    КонецЕсли;

    Аргументы.Добавить("--manifest");
    Аргументы.Добавить(Манифест);

    Фильтр = _Параметры.Фильтр;
    Если Не ПустаяСтрока(Фильтр) Тогда
        Аргументы.Добавить("--filter");
        Аргументы.Добавить(Фильтр);
    КонецЕсли;

    Цель = _Параметры.Цель;
    Если ПустаяСтрока(Цель) Тогда
        Цель = "latest";
    КонецЕсли;

    Аргументы.Добавить("--target");
    Аргументы.Добавить(Цель);

    Если Не ПустаяСтрока(_Параметры.Движок) Тогда
        Аргументы.Добавить("--engine");
        Аргументы.Добавить(_Параметры.Движок);
    КонецЕсли;

    Отчет = _Параметры.ПутьОтчета;
    Если Не ПустаяСтрока(Отчет) Тогда
        Если Версии.ВерсияБольшеИлиРавны(ВерсияDepos, "0.8.0") Тогда
            Аргументы.Добавить("--format");
            Аргументы.Добавить("json");
        КонецЕсли;

        Аргументы.Добавить("--output");
        Аргументы.Добавить(ПреобразоватьПутьОтчета(Отчет));
    КонецЕсли;

    Возврат Аргументы;

КонецФункции

Функция ПреобразоватьПутьОтчета(Отчет)

    Если Не _Исполнитель.ЭтоWindows() Тогда
        Возврат Отчет;
    КонецЕсли;

    Аргументы = Новый Массив;
    Аргументы.Добавить("-w");
    Аргументы.Добавить(Отчет);

    Попытка
        Результат = _Исполнитель.ИсполнитьКоманду("cygpath", Аргументы);
        Если Результат.КодВозврата = 0 Тогда
            Возврат СокрЛП(Результат.Вывод);
        КонецЕсли;
    Исключение
        // cygpath необязателен: depos может принять путь без преобразования.
    КонецПопытки;

    Возврат Отчет;

КонецФункции

Функция ВерсияИзТекста(Текст)

    Шаблон = "[0-9]+[.][0-9]+[.][0-9]+(-[0-9A-Za-z.-]+)?([+][0-9A-Za-z.-]+)?";
    Совпадения = Новый РегулярноеВыражение(Шаблон).НайтиСовпадения(Текст);
    Возврат ?(Совпадения.Количество() = 0, "", Совпадения[0].Значение);

КонецФункции

Функция ПрочитатьВерсиюDepos()

    Версия = _Параметры.ВерсияDepos;
    Если ПустаяСтрока(Версия) Тогда
        ЗавершитьСОшибкой("Отсутствует версия depos", "Передайте DEPOS_VERSION для команды upgrade.");
    КонецЕсли;

    Если ПустаяСтрока(Версия) Или СтрНайти(Версия, Символы.ПС) > 0
        Или СтрНайти(Версия, Символы.ВК) > 0 Тогда
        ЗавершитьСОшибкой("Некорректная версия depos", "Версия должна быть указана одной непустой строкой.");
    КонецЕсли;

    Основа = СтрРазделить(СтрРазделить(Версия, "-")[0], "+")[0];
    Если Не Новый РегулярноеВыражение("^[0-9]+[.][0-9]+[.][0-9]+$").Совпадает(Основа) Тогда
        ЗавершитьСОшибкой("Некорректная версия depos", "Ожидается версия в формате X.Y.Z.");
    КонецЕсли;

    Попытка
        // Проверяем также суффиксы prerelease и build, которые не входят в основу версии.
        Версии.ВерсияИзСтроки(Версия);
    Исключение
        ЗавершитьСОшибкой("Некорректная версия depos", "Ожидается корректная версия в формате X.Y.Z.");
    КонецПопытки;

    Возврат Версия;

КонецФункции

Процедура ЗавершитьСОшибкой(Заголовок, Текст)

    Сообщить(СтрШаблон("::error title=%1::%2", Заголовок, Текст));
    ЗавершитьРаботу(1);

КонецПроцедуры

#КонецОбласти
