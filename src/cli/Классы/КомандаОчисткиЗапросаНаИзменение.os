Перем _Клиент; // КлиентЗапросовНаИзменениеGitHub
Перем _Параметры; // ПараметрыСредыAction

#Область ОбработчикиСобытий

// Создает команду очистки Pull Request.
//
// Параметры:
//   КлиентЗапросовНаИзменениеGitHub - КлиентЗапросовНаИзменениеGitHub - Работает с Pull Request.
//   ПараметрыСредыAction - ПараметрыСредыAction - Значения среды Action.
&КомандаПриложения(Имя = "cleanup-pr", Описание = "Закрыть созданный Action Pull Request")
Процедура ПриСозданииОбъекта(&Пластилин КлиентЗапросовНаИзменениеGitHub, &Пластилин ПараметрыСредыAction)

    _Клиент = КлиентЗапросовНаИзменениеGitHub;
    _Параметры = ПараметрыСредыAction;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Закрывает созданный Action Pull Request и удаляет его ветку, если она не используется другим Pull Request.
//
// Параметры:
//   Команда - КомандаПриложения - Команда CLI.
//
// Исключения:
//   Вызывает исключение, если gh вернул ошибку или некорректный список Pull Request.
Процедура ВыполнитьКоманду(Команда) Экспорт

    Ветка = ОбязательнаяПеременная("DEPOS_BRANCH", _Параметры.Ветка);
    База = ОбязательнаяПеременная("DEPOS_BASE", _Параметры.База);

    Запросы = _Клиент.ПолучитьОткрытые(Ветка);

    Для Каждого Запрос Из Запросы Цикл
        Номер = Неопределено;
        Если ТипЗнч(Запрос) <> Тип("Структура") Или Не Запрос.Свойство("number", Номер) Тогда
            ВызватьИсключение "gh вернул некорректный Pull Request";
        КонецЕсли;

        Если _Клиент.ЭтоУправляемый(Запрос, База) Тогда
            _Клиент.Закрыть(Номер, Запросы.Количество() = 1);
            Возврат;
        КонецЕсли;
    КонецЦикла;

    Сообщить(СтрШаблон("Ветка %1 оставлена без изменений: управляемый Pull Request не найден.", Ветка));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОбязательнаяПеременная(Имя, Значение)

    Если ПустаяСтрока(Значение) Тогда
        ВызватьИсключение "Переменная " + Имя + " обязательна";
    КонецЕсли;

    Возврат Значение;

КонецФункции

#КонецОбласти
