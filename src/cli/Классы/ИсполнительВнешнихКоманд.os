#Использовать 1commands

#Область ОбработчикиСобытий

// Создает исполнитель внешних команд.
&Желудь
Процедура ПриСозданииОбъекта()

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Определяет платформу для выбора пути внешних команд.
//
// Возвращаемое значение:
//   Булево - Истина на Windows.
Функция ЭтоWindows() Экспорт

    Информация = Новый СистемнаяИнформация;
    Возврат СтрНачинаетсяС(Строка(Информация.ТипПлатформы), "Windows");

КонецФункции

// Выполняет внешнюю команду через 1commands.
//
// Параметры:
//   Имя - Строка - Имя команды в PATH.
//   Аргументы - Массив - Аргументы команды.
//   Выводить - Булево - Выводить сообщения команды сразу.
//
// Возвращаемое значение:
//   Структура - КодВозврата и общий Вывод stdout/stderr.
//
// Исключения:
//   Вызывает исключение, если команда не найдена или не запустилась.
Функция ИсполнитьКоманду(Имя, Аргументы, Выводить = Ложь) Экспорт

    Команда = Новый Команда;
    Если ЭтоWindows() И (Имя = "opm" Или Имя = "depos") Тогда
        КаталогКоманд = ПолучитьПеременнуюСреды("OSCRIPTBIN");
        Если ПустаяСтрока(КаталогКоманд) Тогда
            КаталогКоманд = КаталогПрограммы();
        КонецЕсли;

        Если Имя = "opm" Тогда
            Команда.УстановитьКоманду(ОбъединитьПути(КаталогКоманд, "opm.bat"));
        Иначе
            // Аргументы depos передаются напрямую oscript, без интерпретации cmd.exe.
            ПутьСценария = ОбъединитьПути(КаталогКоманд, "../lib/depos/src/cmd/main.os");
            Команда.УстановитьКоманду("oscript");
            Команда.ДобавитьПараметр(АргументКоманды(ПутьСценария));
        КонецЕсли;
    Иначе
        Команда.УстановитьКоманду(Имя);
    КонецЕсли;

    Команда.УстановитьИсполнениеЧерезКомандыСистемы(Ложь);

    Для Каждого Аргумент Из Аргументы Цикл
        Команда.ДобавитьПараметр(АргументКоманды(Аргумент));
    КонецЦикла;

    Команда.ПоказыватьВыводНемедленно(Выводить);

    КодВозврата = Команда.Исполнить();
    Вывод = Команда.ПолучитьВывод();

    Возврат Новый Структура("КодВозврата,Вывод", КодВозврата, Вывод);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция АргументКоманды(Значение)

    Если Не ЭтоWindows() Тогда
        Кавычка = Символ(34);
        Возврат Кавычка + СтрЗаменить(Значение, Кавычка, Кавычка + Кавычка) + Кавычка;
    КонецЕсли;

    Результат = """";
    ОбратныеКосыеЧерты = 0;

    Для Номер = 1 По СтрДлина(Значение) Цикл
        Символ = Сред(Значение, Номер, 1);
        Если Символ = "\" Тогда
            ОбратныеКосыеЧерты = ОбратныеКосыеЧерты + 1;
            Продолжить;
        КонецЕсли;

        Если Символ = """" Тогда
            ОбратныеКосыеЧерты = ОбратныеКосыеЧерты * 2 + 1;
        КонецЕсли;

        Пока ОбратныеКосыеЧерты > 0 Цикл
            Результат = Результат + "\";
            ОбратныеКосыеЧерты = ОбратныеКосыеЧерты - 1;
        КонецЦикла;

        Результат = Результат + Символ;
    КонецЦикла;

    Пока ОбратныеКосыеЧерты > 0 Цикл
        Результат = Результат + "\\";
        ОбратныеКосыеЧерты = ОбратныеКосыеЧерты - 1;
    КонецЦикла;

    Возврат Результат + """";

КонецФункции

#КонецОбласти
