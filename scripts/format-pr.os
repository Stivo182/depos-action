#Использовать "../src/pr"

#Область СлужебныеПроцедурыИФункции

Процедура ЗаписатьВывод(Имя, Значение)

    ПутьВывода = ПолучитьПеременнуюСреды("GITHUB_OUTPUT");

    Разделитель = "depos_" + СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "_");
    Пока СтрНайти(Символы.ПС + Значение + Символы.ПС, Символы.ПС + Разделитель + Символы.ПС) > 0 Цикл
        Разделитель = Разделитель + "_x";
    КонецЦикла;

    Запись = Новый ЗаписьТекста(ПутьВывода, "UTF-8", Символы.ПС, Истина);
    Запись.ЗаписатьСтроку(Имя + "<<" + Разделитель);
    Запись.ЗаписатьСтроку(Значение);
    Запись.ЗаписатьСтроку(Разделитель);
    Запись.Закрыть();

КонецПроцедуры

Процедура ЗавершитьСОшибкой(Заголовок, Текст)

    Сообщить(СтрШаблон("::error title=%1::%2", Заголовок, Текст));
    ЗавершитьРаботу(1);

КонецПроцедуры

#КонецОбласти

#Область Инициализация

ОтчетПуть = ПолучитьПеременнуюСреды("REPORT");
Префикс = ПолучитьПеременнуюСреды("MESSAGE_PREFIX");
ПутьВывода = ПолучитьПеременнуюСреды("GITHUB_OUTPUT");

Если ПустаяСтрока(ОтчетПуть) Тогда
    ЗавершитьСОшибкой("Отсутствует отчёт depos", "Переменная REPORT обязательна");
КонецЕсли;

Если ПустаяСтрока(ПутьВывода) Тогда
    ЗавершитьСОшибкой("Отсутствует GITHUB_OUTPUT", "Переменная GITHUB_OUTPUT обязательна");
КонецЕсли;

Если СтрНайти(Префикс, Символы.ПС) > 0 Или СтрНайти(Префикс, Символы.ВК) > 0 Тогда
    ЗавершитьСОшибкой("Некорректный message-prefix", "Префикс не должен содержать переводы строк.");
КонецЕсли;

Попытка
    ЧитательОтчета = Новый ЧитательОтчетаОбновлений;
    Обновления = ЧитательОтчета.Прочитать(ОтчетПуть);
Исключение
    ЗавершитьСОшибкой("Некорректный отчёт depos", ОписаниеОшибки());
КонецПопытки;

Токен = ПолучитьПеременнуюСреды("GH_TOKEN");
Если Не ПустаяСтрока(Токен) Тогда
    Обновления = МетаданныеGitHub.ОбогатитьВсе(Обновления, Токен);
КонецЕсли;

Форматировщик = Новый ФорматировщикЗапросаНаИзменение;
Результат = Форматировщик.Сформировать(
    Обновления,
    Префикс,
    ПолучитьПеременнуюСреды("DEPOS_PACKAGEDEF"),
    ПолучитьПеременнуюСреды("TARGET")
);

ЗаписатьВывод("title", Результат.Заголовок);
ЗаписатьВывод("body", Результат.Тело);

#КонецОбласти
