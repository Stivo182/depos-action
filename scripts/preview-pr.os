Приложение.Опция("target", "latest", "Тип целевой версии: latest, minor или patch").ТСтрока();
Приложение.Опция("message-prefix", "build(deps)", "Префикс заголовка Pull Request").ТСтрока();
Приложение.Опция("h", Ложь, "Показать справку").Флаг();

Попытка
