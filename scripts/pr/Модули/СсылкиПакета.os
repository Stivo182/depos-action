#Область ПрограммныйИнтерфейс

// Возвращает стандартные ссылки пакета на Hub и GitHub.
//
// Параметры:
//   ИмяПакета - Строка - Имя пакета на Hub.
//
// Возвращаемое значение:
//   Структура - Поля URLHub и URLРепозитория.
Функция Получить(ИмяПакета) Экспорт

    Возврат Новый Структура(
        "URLHub,URLРепозитория",
        "https://hub.oscript.io/package/" + ИмяПакета,
        "https://github.com/oscript-library/" + ИмяПакета
    );

КонецФункции

#КонецОбласти
