#Использовать semver

Перем _Определитель;
Перем _Клиент;

#Область ОбработчикиСобытий

Процедура ПриСозданииОбъекта(Определитель, Клиент)

    _Определитель = Определитель;
    _Клиент = Клиент;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Дополняет обновление ссылками, release notes и commits.
//
// Параметры:
//   Обновление - Структура - Нормализованная запись отчёта depos.
//
// Возвращаемое значение:
//   Структура - Та же запись с полями метаданных Pull Request.
Функция Обогатить(Обновление) Экспорт

    Ссылки = СсылкиПакета.Получить(Обновление.ИмяПакета);

    Обновление.Вставить("URLHub", Ссылки.URLHub);
    Обновление.Вставить("URLРепозитория", Ссылки.URLРепозитория);
    Обновление.Вставить("Релизы", Новый Массив);
    Обновление.Вставить("Коммиты", Новый Массив);
    Обновление.Вставить("URLСравнения", "");

    Репозиторий = _Определитель.Определить(
        Обновление.ИмяПакета,
        Обновление.ВерсияДо,
        Обновление.ВерсияПосле
    );

    Если Репозиторий = Неопределено Тогда
        Возврат Обновление;
    КонецЕсли;

    Обновление.URLРепозитория = Репозиторий.URL;
    Обновление.Релизы = ПодготовитьРелизы(
        _Клиент.ПолучитьРелизы(Репозиторий.ПолноеИмя),
        Обновление.ВерсияДо,
        Обновление.ВерсияПосле
    );

    Если Репозиторий.Сравнение <> Неопределено Тогда
        Обновление.URLСравнения = Репозиторий.Сравнение.URL;
        Обновление.Коммиты = ПодготовитьКоммиты(Репозиторий.Сравнение.Коммиты);
    КонецЕсли;

    Возврат Обновление;

КонецФункции

// Дополняет метаданными все обновления массива.
//
// Параметры:
//   Обновления - Массив из Структура - Записи отчёта depos.
//
// Возвращаемое значение:
//   Массив из Структура - Обогащённые записи.
Функция ОбогатитьВсе(Обновления) Экспорт

    Результат = Новый Массив;
    Для Каждого Обновление Из Обновления Цикл
        Результат.Добавить(Обогатить(Обновление));
    КонецЦикла;

    Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПодготовитьРелизы(ИсходныеРелизы, ВерсияДо, ВерсияПосле)

    Результат = Новый Массив;
    ВерсияДоОбъект = Новый Версия(ВерсияДо);
    ВерсияПослеОбъект = Новый Версия(ВерсияПосле);
    ЦелеваяПредрелизная = ВерсияПослеОбъект.ПреРелиз.Количество() > 0;

    Для Каждого Релиз Из ИсходныеРелизы Цикл
        Если Релиз.draft Или (Релиз.prerelease И Не ЦелеваяПредрелизная) Тогда
            Продолжить;
        КонецЕсли;

        Версия = НормализоватьТег(Релиз.tag_name);
        ВерсияРелиза = Новый Версия(Версия);
        Если ВерсияРелиза.Ошибка() Тогда
            Продолжить;
        КонецЕсли;

        ВДиапазоне = ВерсияРелиза.Сравнить(ВерсияДоОбъект) > 0 И ВерсияРелиза.Сравнить(ВерсияПослеОбъект) <= 0;
        Если Не ВДиапазоне Тогда
            Продолжить;
        КонецЕсли;

        Название = ?(Релиз.name = Null Или ПустаяСтрока(Релиз.name), Версия, Релиз.name);
        Текст = ?(Релиз.body = Null, "", Релиз.body);
        Нормализованный = Новый Структура(
            "Версия,Тег,Название,Текст,URL",
            Версия,
            Релиз.tag_name,
            Название,
            Текст,
            Релиз.html_url
        );
        ВставитьРелизПоУбыванию(Результат, Нормализованный);
    КонецЦикла;

    Возврат Результат;

КонецФункции

Функция ПодготовитьКоммиты(ИсходныеКоммиты)

    Результат = Новый Массив;
    Для Каждого Коммит Из ИсходныеКоммиты Цикл
        Результат.Добавить(Новый Структура(
            "SHA,Сообщение,URL",
            Коммит.sha,
            Коммит.commit.message,
            Коммит.html_url
        ));
    КонецЦикла;

    Возврат Результат;

КонецФункции

Процедура ВставитьРелизПоУбыванию(Релизы, Релиз)

    Для Индекс = 0 По Релизы.Количество() - 1 Цикл
        Если Версии.СравнитьВерсии(Релиз.Версия, Релизы[Индекс].Версия) > 0 Тогда
            Релизы.Вставить(Индекс, Релиз);
            Возврат;
        КонецЕсли;
    КонецЦикла;

    Релизы.Добавить(Релиз);

КонецПроцедуры

Функция НормализоватьТег(Тег)

    Если НРег(Лев(Тег, 3)) = "ver" Тогда
        Возврат Сред(Тег, 4);
    КонецЕсли;

    Если Лев(Тег, 1) = "v" Или Лев(Тег, 1) = "V" Тогда
        Возврат Сред(Тег, 2);
    КонецЕсли;

    Возврат Тег;

КонецФункции

#КонецОбласти
