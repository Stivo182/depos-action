Перем _Клиент;

#Область ОбработчикиСобытий

Процедура ПриСозданииОбъекта(Клиент)

    _Клиент = Клиент;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Определяет репозиторий, которому принадлежит диапазон версий пакета.
//
// Параметры:
//   ИмяПакета - Строка - Имя пакета на Hub.
//   ВерсияДо - Строка - Исходная версия.
//   ВерсияПосле - Строка - Целевая версия.
//
// Возвращаемое значение:
//   Структура, Неопределено - Выбранный репозиторий, разрешённые теги и сравнение.
Функция Определить(ИмяПакета, ВерсияДо, ВерсияПосле) Экспорт

    ОсновноеИмя = "oscript-library/" + ИмяПакета;
    ОсновнойРепозиторий = _Клиент.ПолучитьРепозиторий(ОсновноеИмя);

    Если ОсновнойРепозиторий = Неопределено Тогда
        Возврат Неопределено;
    КонецЕсли;

    ИменаКандидатов = Новый Массив;
    ДобавитьУникальноеИмя(ИменаКандидатов, ОсновноеИмя);
    ИмяИсточника = "";

    Если ОсновнойРепозиторий.ЭтоФорк Тогда
        ДобавитьУникальноеИмя(ИменаКандидатов, ОсновнойРепозиторий.Родитель);
        ДобавитьУникальноеИмя(ИменаКандидатов, ОсновнойРепозиторий.Источник);
        ИмяИсточника = ?(
            ПустаяСтрока(ОсновнойРепозиторий.Источник),
            ОсновнойРепозиторий.Родитель,
            ОсновнойРепозиторий.Источник
        );
    КонецЕсли;

    Лучший = Неопределено;
    Для Каждого ПолноеИмя Из ИменаКандидатов Цикл
        Метаданные = ?(
            ПолноеИмя = ОсновноеИмя,
            ОсновнойРепозиторий,
            _Клиент.ПолучитьРепозиторий(ПолноеИмя)
        );
        Если Метаданные = Неопределено Тогда
            Продолжить;
        КонецЕсли;

        Кандидат = Оценить(Метаданные, ИмяИсточника, ВерсияДо, ВерсияПосле);
        Если Лучший = Неопределено Или ЭтоЛучшийКандидат(Кандидат, Лучший) Тогда
            Лучший = Кандидат;
        КонецЕсли;
    КонецЦикла;

    Возврат Лучший;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Оценить(Метаданные, ИмяИсточника, ВерсияДо, ВерсияПосле)

    ТегДо = РазрешитьТег(Метаданные.ПолноеИмя, ВерсияДо);
    ТегПосле = РазрешитьТег(Метаданные.ПолноеИмя, ВерсияПосле);
    Сравнение = Неопределено;

    Если ТегДо <> Неопределено И ТегПосле <> Неопределено Тогда
        Сравнение = _Клиент.Сравнить(Метаданные.ПолноеИмя, ТегДо, ТегПосле);
    КонецЕсли;

    Если ТегДо <> Неопределено И ТегПосле <> Неопределено И Сравнение <> Неопределено Тогда
        Категория = 3;
    ИначеЕсли ТегДо <> Неопределено И ТегПосле <> Неопределено Тогда
        Категория = 2;
    ИначеЕсли ТегПосле <> Неопределено Тогда
        Категория = 1;
    Иначе
        Категория = 0;
    КонецЕсли;

    Возврат Новый Структура(
        "ПолноеИмя,URL,ТегДо,ТегПосле,Сравнение,Категория,Активен,Обновлен,ЭтоИсточник",
        Метаданные.ПолноеИмя,
        Метаданные.URL,
        ТегДо,
        ТегПосле,
        Сравнение,
        Категория,
        Не Метаданные.Архивирован И Не Метаданные.Отключен,
        Метаданные.Обновлен,
        Не ПустаяСтрока(ИмяИсточника) И Метаданные.ПолноеИмя = ИмяИсточника
    );

КонецФункции

Функция РазрешитьТег(ПолноеИмя, ПредставлениеВерсии)

    Результат = _Клиент.РазрешитьТег(ПолноеИмя, ПредставлениеВерсии);
    Если Результат <> Неопределено Тогда
        Возврат Результат;
    КонецЕсли;

    НормализованнаяВерсия = Новый Версия(ПредставлениеВерсии);
    НормализованноеПредставление = НормализованнаяВерсия.ВСтроку();

    Если НормализованноеПредставление = ПредставлениеВерсии Тогда
        Возврат Неопределено;
    КонецЕсли;

    Возврат _Клиент.РазрешитьТег(ПолноеИмя, НормализованноеПредставление);

КонецФункции

Функция ЭтоЛучшийКандидат(Кандидат, Текущий)

    Если Кандидат.Категория <> Текущий.Категория Тогда
        Возврат Кандидат.Категория > Текущий.Категория;
    КонецЕсли;

    Если Кандидат.Активен <> Текущий.Активен Тогда
        Возврат Кандидат.Активен;
    КонецЕсли;

    Если Кандидат.Обновлен <> Текущий.Обновлен Тогда
        Возврат Кандидат.Обновлен > Текущий.Обновлен;
    КонецЕсли;

    Если Кандидат.ЭтоИсточник <> Текущий.ЭтоИсточник Тогда
        Возврат Кандидат.ЭтоИсточник;
    КонецЕсли;

    Возврат Ложь;

КонецФункции

Процедура ДобавитьУникальноеИмя(Имена, Имя)

    Если ПустаяСтрока(Имя) Или Имена.Найти(Имя) <> Неопределено Тогда
        Возврат;
    КонецЕсли;

    Имена.Добавить(Имя);

КонецПроцедуры

#КонецОбласти
